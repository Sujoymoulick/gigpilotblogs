---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const categories = [
	'All',
	'Money & Online Income',
	'Productivity & Tools',
	'Freelancing',
	'Freelance Jobs',
	'Platforms',
	'Work From Home',
	'Freelance Skills',
	'Build with AI',
	'Career',
];

const pageTitle = 'Freelancing & AI Guides | GigPilot AI Knowledge Hub';
const pageDescription =
	'Explore in-depth freelancing tutorials, platform strategies, and AI tools for independent professionals. Learn how to land clients and scale your income.';

const breadcrumbs = [{ name: 'Blog', item: '/blog/' }];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
		/>
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumbs items={breadcrumbs} />
			<header class="blog-header">
				<span class="badge">Knowledge Hub</span>
				<h1>Freelancing Guides &amp; Insights</h1>
				<p class="subtitle">
					Practical guides covering freelancing, freelance jobs, online work, platforms, skills, and AI productivity to help you succeed independently.
				</p>

				<!-- Smart Search Bar with Keyword Tracking -->
				<div class="search-container">
					<div class="search-input-wrapper">
						<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="text"
							id="blogSearchInput"
							class="search-input"
							placeholder="Search guides by title, topic, or keyword (e.g. 'PDF to Excel', 'Students', 'Upwork')..."
							aria-label="Search blog posts"
							autocomplete="off"
						/>
						<button type="button" id="clearSearchBtn" class="clear-search-btn" aria-label="Clear search" style="display: none;">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
						</button>
					</div>

					<div class="search-meta">
						<span id="searchResultCount" class="result-count">Showing all {posts.length} articles</span>
						<div class="popular-keywords">
							<span class="keywords-label">Popular Searches:</span>
							<button type="button" class="keyword-chip" data-keyword="PDF to Excel">PDF to Excel</button>
							<button type="button" class="keyword-chip" data-keyword="Earn Money">Earn Money</button>
							<button type="button" class="keyword-chip" data-keyword="Students">Students</button>
							<button type="button" class="keyword-chip" data-keyword="Freelancing">Freelancing</button>
							<button type="button" class="keyword-chip" data-keyword="Upwork">Upwork</button>
							<button type="button" class="keyword-chip" data-keyword="AstroJS">AstroJS</button>
						</div>
					</div>
				</div>

				<!-- Category Filters -->
				<div class="category-pills" id="categoryFilter">
					{
						categories.map((cat, idx) => (
							<button
								type="button"
								class={`pill-btn ${idx === 0 ? 'active' : ''}`}
								data-category={cat}
							>
								{cat}
							</button>
						))
					}
				</div>
			</header>

			<!-- Featured Post Hero Card -->
			{
				featuredPost && (
					<section
						class="featured-section"
						data-post-category={featuredPost.data.category || 'Freelancing'}
						data-title={featuredPost.data.title}
						data-description={featuredPost.data.description}
					>
						<a href={`/blog/${featuredPost.id}/`} class="featured-card">
							<div class="featured-img-container">
								{featuredPost.data.heroImage && (
									<Image
										width={800}
										height={450}
										src={featuredPost.data.heroImage}
										alt={`${featuredPost.data.title} - featured article`}
										class="featured-img"
									/>
								)}
							</div>
							<div class="featured-content">
								<div class="card-meta">
									<span class="badge">{featuredPost.data.category || 'Featured'}</span>
									<span class="read-time">{featuredPost.data.readingTime || '8 min read'}</span>
								</div>
								<h2>{featuredPost.data.title}</h2>
								<p class="excerpt">{featuredPost.data.description}</p>
								<div class="card-footer">
									<span class="date">
										<FormattedDate date={featuredPost.data.pubDate} />
									</span>
									<span class="read-more">Read Full Guide &rarr;</span>
								</div>
							</div>
						</a>
					</section>
				)
			}

			<!-- Blog Post Grid -->
			<section class="posts-grid-section">
				<h2 class="grid-heading">All Articles ({posts.length})</h2>

				<!-- Empty Search Result Card -->
				<div class="no-results-card" id="noResultsCard" style="display: none;">
					<div class="no-results-icon">🔍</div>
					<h3>No articles found</h3>
					<p id="noResultsText">We couldn't find any guides matching your search query.</p>
					<button type="button" id="resetSearchBtn" class="btn-reset-search">Clear Search &amp; Show All Guides</button>
				</div>

				<div class="posts-grid" id="postsGrid">
					{
						posts.map((post) => (
							<article
								class="post-card"
								data-category={post.data.category || 'Freelancing'}
								data-title={post.data.title}
								data-description={post.data.description}
							>
								<a href={`/blog/${post.id}/`} class="post-card-inner">
									<div class="post-img-wrapper">
										{post.data.heroImage && (
											<Image
												width={600}
												height={340}
												src={post.data.heroImage}
												alt={`${post.data.title} - guide thumbnail`}
												class="post-img"
											/>
										)}
									</div>
									<div class="post-card-body">
										<div class="card-meta">
											<span class="badge">{post.data.category || 'Freelancing'}</span>
											<span class="read-time">{post.data.readingTime || '8 min read'}</span>
										</div>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-excerpt">{post.data.description}</p>
										<div class="post-card-footer">
											<span class="post-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
											<span class="read-link">Read Guide &rarr;</span>
										</div>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Smart Search & Category Filter with Keyword Analytics Tracking
			const searchInput = document.getElementById('blogSearchInput') as HTMLInputElement;
			const clearSearchBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement;
			const searchResultCount = document.getElementById('searchResultCount') as HTMLElement;
			const keywordChips = document.querySelectorAll('.keyword-chip');
			const filterButtons = document.querySelectorAll('.pill-btn');
			const postCards = document.querySelectorAll('.post-card');
			const featuredSection = document.querySelector('.featured-section') as HTMLElement;
			const gridHeading = document.querySelector('.grid-heading') as HTMLElement;
			const noResultsCard = document.getElementById('noResultsCard') as HTMLElement;
			const resetSearchBtn = document.getElementById('resetSearchBtn') as HTMLButtonElement;

			let currentCategory = 'All';
			let currentSearchQuery = '';
			let trackingTimeout: any = null;

			// Send search keyword event to Google Analytics (gtag) and save in localStorage
			function trackKeyword(query: string) {
				const cleanQuery = query.trim().toLowerCase();
				if (!cleanQuery || cleanQuery.length < 2) return;

				// 1. Google Analytics Event Tracking
				if (typeof (window as any).gtag === 'function') {
					(window as any).gtag('event', 'search', {
						search_term: cleanQuery,
						event_category: 'Blog Search',
						event_label: cleanQuery,
					});
				}

				// 2. Persist recent search query in localStorage
				try {
					const history: string[] = JSON.parse(localStorage.getItem('gigpilot_search_history') || '[]');
					if (!history.includes(cleanQuery)) {
						history.unshift(cleanQuery);
						if (history.length > 10) history.pop();
						localStorage.setItem('gigpilot_search_history', JSON.stringify(history));
					}
				} catch (e) {}
			}

			function filterPosts() {
				const query = currentSearchQuery.trim().toLowerCase();
				let visibleCount = 0;
				const totalCount = postCards.length + (featuredSection ? 1 : 0);

				// Clear button toggle
				if (clearSearchBtn) {
					clearSearchBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
				}

				// Filter featured section
				if (featuredSection) {
					const featCategory = featuredSection.getAttribute('data-post-category') || '';
					const featTitle = (featuredSection.getAttribute('data-title') || '').toLowerCase();
					const featDesc = (featuredSection.getAttribute('data-description') || '').toLowerCase();

					const matchesCategory = currentCategory === 'All' || featCategory === currentCategory;
					const matchesSearch =
						!query ||
						featTitle.includes(query) ||
						featDesc.includes(query) ||
						featCategory.toLowerCase().includes(query);

					if (matchesCategory && matchesSearch) {
						featuredSection.style.display = 'block';
						visibleCount++;
					} else {
						featuredSection.style.display = 'none';
					}
				}

				// Filter post cards
				postCards.forEach((card) => {
					const cardEl = card as HTMLElement;
					const cardCategory = cardEl.getAttribute('data-category') || '';
					const cardTitle = (cardEl.getAttribute('data-title') || '').toLowerCase();
					const cardDesc = (cardEl.getAttribute('data-description') || '').toLowerCase();

					const matchesCategory = currentCategory === 'All' || cardCategory === currentCategory;
					const matchesSearch =
						!query ||
						cardTitle.includes(query) ||
						cardDesc.includes(query) ||
						cardCategory.toLowerCase().includes(query);

					if (matchesCategory && matchesSearch) {
						cardEl.style.display = 'block';
						visibleCount++;
					} else {
						cardEl.style.display = 'none';
					}
				});

				// Update result count header
				if (searchResultCount) {
					if (query) {
						searchResultCount.textContent = `Found ${visibleCount} guide${visibleCount === 1 ? '' : 's'} for "${currentSearchQuery}"`;
					} else if (currentCategory !== 'All') {
						searchResultCount.textContent = `Showing ${visibleCount} guide${visibleCount === 1 ? '' : 's'} in ${currentCategory}`;
					} else {
						searchResultCount.textContent = `Showing all ${totalCount} articles`;
					}
				}

				if (gridHeading) {
					gridHeading.textContent =
						query || currentCategory !== 'All'
							? `Matching Articles (${visibleCount})`
							: `All Articles (${totalCount})`;
				}

				// Handle No Results Empty State
				if (noResultsCard) {
					noResultsCard.style.display = visibleCount === 0 ? 'block' : 'none';
				}
			}

			// Debounced search input handler
			if (searchInput) {
				searchInput.addEventListener('input', (e) => {
					currentSearchQuery = (e.target as HTMLInputElement).value;
					filterPosts();

					clearTimeout(trackingTimeout);
					if (currentSearchQuery.trim().length >= 3) {
						trackingTimeout = setTimeout(() => {
							trackKeyword(currentSearchQuery);
						}, 750);
					}
				});
			}

			// Clear button handler
			if (clearSearchBtn) {
				clearSearchBtn.addEventListener('click', () => {
					if (searchInput) searchInput.value = '';
					currentSearchQuery = '';
					filterPosts();
					searchInput?.focus();
				});
			}

			// Reset search button handler
			if (resetSearchBtn) {
				resetSearchBtn.addEventListener('click', () => {
					if (searchInput) searchInput.value = '';
					currentSearchQuery = '';
					currentCategory = 'All';
					filterButtons.forEach((b) => b.classList.remove('active'));
					if (filterButtons[0]) filterButtons[0].classList.add('active');
					filterPosts();
				});
			}

			// Popular keyword chips handler
			keywordChips.forEach((chip) => {
				chip.addEventListener('click', () => {
					const keyword = chip.getAttribute('data-keyword') || '';
					if (searchInput) searchInput.value = keyword;
					currentSearchQuery = keyword;
					filterPosts();
					trackKeyword(keyword);
				});
			});

			// Category filter pills handler
			filterButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					filterButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					currentCategory = btn.getAttribute('data-category') || 'All';
					filterPosts();
				});
			});
		</script>
	</body>
</html>

<style>
	/* ── Local variables (shared light/dark) ── */
	:root,
	[data-theme='light'] {
		--gray-border: 215, 220, 230;
		--radius-lg: 1rem;
		--radius-md: 0.6rem;
		--accent-border: #93c5fd;
		--box-shadow-hover:
			0 4px 12px rgba(var(--gray), 35%), 0 12px 32px rgba(var(--gray), 40%),
			0 20px 40px rgba(var(--gray), 35%);
		--card-bg: #ffffff;
	}

	[data-theme='dark'] {
		--gray-border: 45, 45, 55;
		--accent-border: #1d4ed8;
		--box-shadow-hover:
			0 4px 12px rgba(0, 0, 0, 0.9), 0 12px 32px rgba(0, 0, 0, 0.9),
			0 20px 40px rgba(0, 0, 0, 0.9);
		--card-bg: #111111;
	}

	/* Wider layout for the 3-column grid */
	main {
		width: var(--max-width);
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}

	/* Badge */
	.badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		background: #e8edf5;
		color: #1a3561;
		padding: 0.25em 0.65em;
		border-radius: 4px;
	}

	[data-theme='dark'] .badge {
		background: #1e2d4a;
		color: #93c5fd;
	}

	.blog-header {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 3rem auto;
	}

	.blog-header .badge {
		margin-bottom: 1rem;
	}

	.blog-header h1 {
		font-size: 2.75rem;
		margin-bottom: 1rem;
		letter-spacing: -0.03em;
		color: rgb(var(--black));
	}

	.subtitle {
		font-size: 1.2rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.category-pills {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.pill-btn {
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-border));
		color: rgb(var(--gray-dark));
		padding: 0.45rem 1rem;
		border-radius: 9999px;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.pill-btn:hover {
		background: rgb(var(--gray-light));
		border-color: rgb(var(--gray-border));
	}

	.pill-btn.active {
		background: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
	}

	/* Featured Card */
	.featured-section {
		margin-bottom: 4rem;
	}

	.featured-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2.5rem;
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-border));
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		box-shadow: var(--box-shadow);
		text-decoration: none;
		transition: all 0.25s ease;
		align-items: center;
	}

	.featured-card:hover {
		box-shadow: var(--box-shadow-hover);
		transform: translateY(-2px);
		border-color: var(--accent-border);
	}

	.featured-img-container {
		width: 100%;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.featured-img {
		width: 100%;
		height: 320px;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.featured-card:hover .featured-img {
		transform: scale(1.02);
	}

	.featured-content {
		display: flex;
		flex-direction: column;
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.read-time {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		font-weight: 500;
	}

	.featured-content h2 {
		font-size: 1.75rem;
		line-height: 1.3;
		margin-bottom: 0.75rem;
		color: rgb(var(--black));
	}

	.featured-content .excerpt {
		color: rgb(var(--gray));
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-border));
	}

	.date {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.read-more {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
	}

	/* Posts Grid */
	.posts-grid-section {
		margin-top: 2rem;
	}

	.grid-heading {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		color: rgb(var(--black));
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}

	.post-card {
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-border));
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--box-shadow);
		transition: all 0.2s ease;
	}

	.post-card:hover {
		box-shadow: var(--box-shadow-hover);
		transform: translateY(-2px);
		border-color: var(--accent-border);
	}

	.post-card-inner {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.post-img-wrapper {
		width: 100%;
		height: 190px;
		overflow: hidden;
		background: rgb(var(--gray-light));
	}

	.post-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.25s ease;
	}

	.post-card:hover .post-img {
		transform: scale(1.03);
	}

	.post-card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.post-title {
		font-size: 1.15rem;
		line-height: 1.4;
		margin: 0 0 0.5rem 0;
		color: rgb(var(--black));
	}

	.post-excerpt {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		margin-bottom: 1.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card-footer {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 0.75rem;
		border-top: 1px solid rgb(var(--gray-border));
		font-size: 0.8rem;
	}

	.post-date {
		color: rgb(var(--gray));
	}

	.read-link {
		color: var(--accent);
		font-weight: 600;
	}

	@media (max-width: 960px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}

		.featured-card {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.featured-img {
			height: 260px;
		}
	}

	@media (max-width: 640px) {
		main {
			padding: 1.75rem 1rem 3rem;
		}

		.blog-header {
			margin-bottom: 2rem;
		}

		.blog-header h1 {
			font-size: 2rem;
			margin-bottom: 0.75rem;
		}

		.subtitle {
			font-size: 1rem;
			margin-bottom: 1.25rem;
		}

		.category-pills {
			gap: 0.4rem;
		}

		.pill-btn {
			padding: 0.4rem 0.8rem;
			font-size: 0.82rem;
		}

		.featured-section {
			margin-bottom: 2.5rem;
		}

		.featured-card {
			padding: 1.25rem 1rem;
		}

		.featured-img {
			height: 200px;
		}

		.featured-content h2 {
			font-size: 1.35rem;
		}

		.featured-content .excerpt {
			font-size: 0.92rem;
			margin-bottom: 1rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.post-img-wrapper {
			height: 180px;
		}

		.post-card-body {
			padding: 1rem;
		}

		.post-title {
			font-size: 1.1rem;
		}

		.grid-heading {
			font-size: 1.35rem;
			margin-bottom: 1rem;
		}
	}

	@media (max-width: 400px) {
		.blog-header h1 {
			font-size: 1.75rem;
		}

		.featured-img {
			height: 170px;
		}
	}

	/* ── Smart Search Bar & Keyword Tracking Styling ── */
	.search-container {
		max-width: 680px;
		margin: 1.75rem auto 1.5rem;
