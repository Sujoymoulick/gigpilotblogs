---
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const pageTitle = 'Privacy Policy | GigPilot AI';
const pageDescription =
	'Learn how GigPilot AI protects your data. Discover our privacy-by-design principles, 100% client-side calculator architecture, and data practices.';

const breadcrumbs = [
	{ name: 'Privacy Policy', item: '/privacy/' },
];

const lastUpdated = 'August 20, 2026';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
		/>
	</head>
	<body>
		<Header />
		<main class="legal-main">
			<Breadcrumbs items={breadcrumbs} />

			<div class="legal-header">
				<div class="legal-badge">Privacy First</div>
				<h1 class="legal-title">Privacy Policy</h1>
				<p class="legal-meta">
					Effective Date: <strong>August 20, 2026</strong> &bull; Last Updated: <strong>{lastUpdated}</strong>
				</p>
				<p class="legal-lead">
					At <strong>GigPilot AI</strong> (<a href="https://gigpilotai.com">https://gigpilotai.com</a>), we believe in fundamental data privacy, transparent operations, and privacy-by-design. This Privacy Policy details the types of information we collect, how it is used, and how your privacy is protected when using our tools and publications.
				</p>
			</div>

			<!-- Privacy At a Glance Box -->
			<div class="privacy-highlights">
				<h2 class="highlights-title">Privacy at a Glance</h2>
				<div class="highlights-grid">
					<div class="highlight-item">
						<div class="highlight-icon">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
							</svg>
						</div>
						<div>
							<strong>Zero Financial Data Stored</strong>
							<p>All rate and project quote calculators execute 100% in your browser. Your rates and expenses never leave your device.</p>
						</div>
					</div>

					<div class="highlight-item">
						<div class="highlight-icon">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
							</svg>
						</div>
						<div>
							<strong>No Sale of Personal Data</strong>
							<p>We do not sell, rent, monetize, or trade your personal information or email addresses with any third-party brokers.</p>
						</div>
					</div>

					<div class="highlight-item">
						<div class="highlight-icon">
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<div>
							<strong>Minimal &amp; Transparent Collection</strong>
							<p>We only collect data you explicitly provide (such as contact messages) and standard server security logs.</p>
						</div>
					</div>
				</div>
			</div>

			<div class="legal-layout">
				<!-- Quick Jump Navigation -->
				<aside class="legal-sidebar" aria-label="Table of Contents">
					<div class="toc-card">
						<h2 class="toc-title">Table of Contents</h2>
						<ul class="toc-list">
							<li><a href="#client-side-guarantee">1. 100% Browser-Side Calculators</a></li>
							<li><a href="#information-collected">2. Information We Collect</a></li>
							<li><a href="#how-we-use">3. How We Use Information</a></li>
							<li><a href="#cookies-storage">4. Cookies &amp; Local Storage</a></li>
							<li><a href="#analytics">5. Analytics &amp; Performance</a></li>
							<li><a href="#third-parties">6. Third-Party Services</a></li>
							<li><a href="#data-security">7. Data Security &amp; Retention</a></li>
							<li><a href="#your-rights">8. Your Privacy Rights (GDPR / CCPA)</a></li>
							<li><a href="#children">9. Children's Privacy</a></li>
							<li><a href="#policy-changes">10. Policy Updates</a></li>
							<li><a href="#contact-privacy">11. Contact Privacy Team</a></li>
						</ul>
					</div>
				</aside>

				<!-- Main Legal Content -->
				<article class="legal-content">
					<section id="client-side-guarantee" class="legal-section">
						<h2>1. Our 100% Browser-Side Calculator Guarantee</h2>
						<p>
							A core architectural principle of <strong>GigPilot AI</strong> is client-side execution for all financial and pricing tools:
						</p>
						<ul>
							<li>Our <a href="/">Freelance Rate Calculator</a> and <a href="/tools/freelance-rate-calculator">Project Quote Calculator</a> run entirely within your web browser using client-side JavaScript.</li>
							<li>Any numbers, hourly rates, monthly living expenses, target profits, tax brackets, or project scope estimates entered into these forms <strong>are never transmitted to our servers or saved in remote databases</strong>.</li>
							<li>When you refresh or close your browser tab, your entered calculations are reset immediately unless you manually copy them.</li>
						</ul>
					</section>

					<section id="information-collected" class="legal-section">
						<h2>2. Information We Collect</h2>
						<p>
							We collect information in two limited categories:
						</p>
						<h3>A. Information You Voluntarily Provide</h3>
						<p>
							When you contact us via our <a href="/contact">Contact Page</a> or send an email to our support desk, we collect the information you choose to submit, including your name, email address, inquiry subject, and the contents of your message.
						</p>
						<h3>B. Automated Technical &amp; Diagnostic Information</h3>
						<p>
							Like virtually all web applications, when you visit our website, our hosting infrastructure (e.g., Cloudflare Pages) automatically logs basic technical request data. This may include your IP address, browser type, operating system, referring URL, pages viewed, and timestamps. This information is processed exclusively for DDoS defense, routing optimization, and site uptime reliability.
						</p>
					</section>

					<section id="how-we-use" class="legal-section">
						<h2>3. How We Use Information</h2>
						<p>
							We use the limited information collected strictly for legitimate operational purposes:
						</p>
						<ul>
							<li>To respond promptly to your support questions, feedback, or partnership inquiries.</li>
							<li>To maintain, protect, and optimize the security and performance of our web infrastructure.</li>
							<li>To detect, prevent, and mitigate spam, fraud, and cyber security incidents.</li>
							<li>To comply with legal and regulatory obligations.</li>
						</ul>
					</section>

					<section id="cookies-storage" class="legal-section">
						<h2>4. Cookies &amp; Local Storage</h2>
						<p>
							We strive to minimize cookie usage. Here is how local storage and cookies are utilized on GigPilot AI:
						</p>
						<ul>
							<li><strong>Theme Preference (`localStorage.getItem('theme')`):</strong> We store your preferred display mode (light mode or dark mode) directly in your browser's local storage so your visual preference persists across pages without requiring a server cookie or user profile.</li>
							<li><strong>Essential Session Cookies:</strong> Our hosting provider (Cloudflare) may place essential security cookies (such as `__cf_bm`) solely to distinguish human visitors from automated malicious bot traffic.</li>
						</ul>
						<p>
							You can configure your browser to block or delete cookies and local storage items at any time through your browser preferences.
						</p>
					</section>

					<section id="analytics" class="legal-section">
						<h2>5. Analytics &amp; Performance Measurement</h2>
						<p>
							We may use privacy-centric, cookieless analytics to measure general website traffic trends (such as top visited articles, page load speeds, and geographic regions by country). These analytics solutions do not track individual users across the web, do not create digital fingerprinting profiles, and do not store personal identification information.
						</p>
					</section>

					<section id="third-parties" class="legal-section">
						<h2>6. Third-Party Services &amp; External Links</h2>
						<p>
							Our website contains outbound links to external platforms, such as Fiverr, Upwork, Next.js, Cloudflare, GitHub, and social channels. Please note that once you navigate away from GigPilot AI to an external website, their respective privacy policies and data collection terms apply. We strongly recommend reviewing the privacy notices of any external site you visit.
						</p>
					</section>

					<section id="data-security" class="legal-section">
						<h2>7. Data Security &amp; Retention</h2>
						<p>
							We implement industry-standard technical and organizational security measures to protect any data under our control against unauthorized access, loss, alteration, or disclosure. All communication with our site is encrypted in transit using Transport Layer Security (TLS/HTTPS).
						</p>
						<p>
							Support messages submitted via our contact forms are retained only for as long as necessary to address your inquiry or comply with record-keeping obligations.
						</p>
					</section>

					<section id="your-rights" class="legal-section">
						<h2>8. Your Privacy Rights (GDPR, CCPA &amp; Global)</h2>
						<p>
							Depending on your location, you may have specific statutory rights regarding your personal information under data protection regulations (such as the EU General Data Protection Regulation / GDPR or the California Consumer Privacy Act / CCPA):
						</p>
						<ul>
							<li><strong>Right to Access:</strong> You have the right to request a copy of any personal data we hold about you.</li>
							<li><strong>Right to Rectification:</strong> You can request corrections to inaccurate or incomplete information.</li>
							<li><strong>Right to Erasure ("Right to Be Forgotten"):</strong> You may request that we delete personal data associated with your contact communications.</li>
							<li><strong>Right to Object &amp; Restrict Processing:</strong> You have the right to object to certain types of processing.</li>
							<li><strong>Non-Discrimination:</strong> We will never discriminate against you for exercising your privacy rights.</li>
						</ul>
						<p>
							To exercise any of these rights, please email us at <a href="mailto:privacy@gigpilotai.com">privacy@gigpilotai.com</a>.
						</p>
					</section>

					<section id="children" class="legal-section">
						<h2>9. Children's Privacy</h2>
						<p>
							GigPilot AI is designed for working adults, freelancers, and students pursuing independent contracting careers. We do not knowingly collect or solicit personal data from children under the age of 16. If we become aware that we have collected information from a child under 16 without verified parental consent, we will promptly delete that information from our records.
						</p>
					</section>

					<section id="policy-changes" class="legal-section">
						<h2>10. Changes to This Privacy Policy</h2>
						<p>
							We may update our Privacy Policy periodically to reflect enhancements to our tools, legal requirements, or architectural changes. All updates will be published on this page with a revised "Last Updated" date. We encourage visitors to review this policy occasionally.
						</p>
					</section>

					<section id="contact-privacy" class="legal-section">
						<h2>11. Contact Our Privacy Team</h2>
						<p>
							If you have questions, privacy concerns, or data requests regarding this Privacy Policy, please get in touch:
						</p>
						<div class="contact-box">
							<p><strong>GigPilot AI Privacy &amp; Data Governance</strong></p>
							<p>Email: <a href="mailto:privacy@gigpilotai.com">privacy@gigpilotai.com</a> / <a href="mailto:support@gigpilotai.com">support@gigpilotai.com</a></p>
							<p>Web Contact: <a href="/contact">https://gigpilotai.com/contact</a></p>
						</div>
					</section>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.legal-main {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 5rem;
	}

	.legal-header {
		max-width: 800px;
		margin-bottom: 2.5rem;
	}

	.legal-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.75rem;
		background: rgba(16, 185, 129, 0.1);
		color: #059669;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}

	[data-theme='dark'] .legal-badge {
		color: #34d399;
		background: rgba(16, 185, 129, 0.2);
	}

	.legal-title {
		font-size: 2.8rem;
		font-weight: 800;
		color: rgb(var(--black));
		line-height: 1.15;
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}

	.legal-meta {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		margin-bottom: 1.25rem;
	}

	.legal-lead {
		font-size: 1.15rem;
		line-height: 1.65;
		color: var(--text);
	}

	/* Highlights box */
	.privacy-highlights {
		background: rgba(37, 99, 235, 0.04);
		border: 1.5px solid var(--border);
		border-radius: 14px;
		padding: 2rem;
		margin-bottom: 3.5rem;
	}

	.highlights-title {
		font-size: 1.3rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 1.5rem;
	}

	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.highlight-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.highlight-icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(37, 99, 235, 0.1);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.highlight-item strong {
		display: block;
		font-size: 1rem;
		color: rgb(var(--black));
		margin-bottom: 0.25rem;
	}

	.highlight-item p {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	.legal-layout {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: 3rem;
		align-items: flex-start;
	}

	/* Sidebar TOC */
	.legal-sidebar {
		position: sticky;
		top: 80px;
	}

	.toc-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.25rem;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
	}

	.toc-title {
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin: 0 0 0.85rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.toc-list a {
		font-size: 0.88rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		display: block;
		padding: 0.2rem 0;
		transition: color 0.15s ease;
		line-height: 1.4;
	}

	.toc-list a:hover {
		color: var(--accent);
	}

	/* Content */
	.legal-content {
		color: var(--text);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.legal-section {
		margin-bottom: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
		scroll-margin-top: 90px;
	}

	.legal-section:last-child {
		border-bottom: none;
	}

	.legal-section h2 {
		font-size: 1.65rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 1rem;
		letter-spacing: -0.01em;
	}

	.legal-section h3 {
		font-size: 1.25rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 1.5rem 0 0.5rem;
	}

	.legal-section p {
		margin-bottom: 1.25rem;
	}

	.legal-section ul {
		margin: 0 0 1.5rem 1.5rem;
		padding: 0;
	}

	.legal-section li {
		margin-bottom: 0.6rem;
	}

	.contact-box {
		background: var(--bg-code);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.25rem 1.5rem;
		margin-top: 1rem;
	}

	.contact-box p {
		margin: 0.25rem 0;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.legal-layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.legal-sidebar {
			position: static;
		}

		.legal-title {
			font-size: 2.2rem;
		}
	}

	@media (max-width: 640px) {
		.legal-main {
			padding: 1.5rem 1rem 3.5rem;
		}

		.legal-title {
			font-size: 1.85rem;
		}

		.legal-lead {
			font-size: 1rem;
		}

		.privacy-highlights {
			padding: 1.25rem 1rem;
			margin-bottom: 2.5rem;
		}

		.highlights-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.legal-section {
			margin-bottom: 2rem;
			padding-bottom: 1.75rem;
		}

		.legal-section h2 {
			font-size: 1.35rem;
		}

		.legal-section h3 {
			font-size: 1.15rem;
		}

		.legal-section p {
			font-size: 0.95rem;
		}

		.legal-section ul {
			margin: 0 0 1.25rem 1.15rem;
		}

		.contact-box {
			padding: 1rem;
		}
	}

	@media (max-width: 400px) {
		.legal-title {
			font-size: 1.65rem;
		}
	}
</style>
