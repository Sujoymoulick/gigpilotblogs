---
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const pageTitle = '500: Server Error | GigPilot AI';
const pageDescription =
	'Something unexpected happened on our server. Our team has been alerted. In the meantime, all browser-based calculators remain fully functional.';

const breadcrumbs = [
	{ name: '500 Server Error', item: '/500' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
			noindex={true}
		/>
	</head>
	<body>
		<Header />
		<main class="error-main">
			<Breadcrumbs items={breadcrumbs} />

			<section class="error-hero">
				<div class="status-pill server-error-pill">
					<span class="status-code">500</span>
					<span class="status-divider"></span>
					<span class="status-label">Internal Server Error</span>
				</div>

				<h1 class="error-title">Temporary Engine Malfunction</h1>
				<p class="error-subtitle">
					Something unexpected occurred while processing this request. Our automated error monitors have logged the issue and our team is actively resolving it.
				</p>

				<div class="status-card">
					<div class="status-card-header">
						<span class="status-dot"></span>
						<span class="status-heading">Client-Side Tools Status: <strong>100% Operational</strong></span>
					</div>
					<p class="status-note">
						Good news: All GigPilot AI rate calculators, project quotation models, and prompt generators execute entirely in your local browser without relying on cloud backends.
					</p>
				</div>

				<div class="hero-actions">
					<button type="button" class="btn btn-primary" id="btn-retry">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
						</svg>
						Try Reloading Page
					</button>
					<a href="/" class="btn btn-secondary">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
							<polyline points="9 22 9 12 15 12 15 22"></polyline>
						</svg>
						Return to Homepage
					</a>
					<a href="/contact" class="btn btn-outline">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
						</svg>
						Contact Support
					</a>
				</div>
			</section>

			<section class="troubleshooting-grid">
				<div class="trouble-card">
					<div class="trouble-icon">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="4" y="2" width="16" height="20" rx="2"></rect>
							<line x1="8" y1="6" x2="16" y2="6"></line>
							<line x1="16" y1="14" x2="16" y2="18"></line>
							<path d="M16 10h.01"></path>
							<path d="M12 10h.01"></path>
							<path d="M8 10h.01"></path>
							<path d="M12 14h.01"></path>
							<path d="M8 14h.01"></path>
							<path d="M12 18h.01"></path>
							<path d="M8 18h.01"></path>
						</svg>
					</div>
					<h3>Freelancer Rate Calculator</h3>
					<p>Calculate your required hourly and baseline pricing using zero-tracking local computation.</p>
					<a href="/tools/freelance-rate-calculator">Open Calculator &rarr;</a>
				</div>

				<div class="trouble-card">
					<div class="trouble-icon">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
							<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
						</svg>
					</div>
					<h3>Knowledge Hub &amp; Guides</h3>
					<p>Access our library of static tutorials on platforms, client acquisition, and building with AI.</p>
					<a href="/blog">Browse Guides &rarr;</a>
				</div>

				<div class="trouble-card">
					<div class="trouble-icon">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
						</svg>
					</div>
					<h3>Reach Our Helpdesk</h3>
					<p>If you suspect an outage or encountered a broken endpoint, drop our team a quick note.</p>
					<a href="/contact">Contact Support &rarr;</a>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			document.getElementById('btn-retry')?.addEventListener('click', () => {
				window.location.reload();
			});
		</script>
	</body>
</html>

<style>
	.error-main {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	.error-hero {
		text-align: center;
		padding: 3rem 1rem 3.5rem;
		max-width: 760px;
		margin: 0 auto;
	}

	.server-error-pill {
		background: rgba(239, 68, 68, 0.08) !important;
		border: 1px solid rgba(239, 68, 68, 0.25) !important;
	}

	.server-error-pill .status-code,
	.server-error-pill .status-label {
		color: #dc2626 !important;
	}

	.server-error-pill .status-divider {
		background: rgba(239, 68, 68, 0.3) !important;
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.4rem 1.1rem;
		border-radius: 9999px;
		margin-bottom: 1.5rem;
	}

	.status-code {
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: 0.05em;
	}

	.status-divider {
		width: 1px;
		height: 14px;
	}

	.status-label {
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.error-title {
		font-size: 2.6rem;
		font-weight: 800;
		line-height: 1.2;
		color: rgb(var(--black));
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.error-subtitle {
		font-size: 1.15rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin-bottom: 2rem;
		max-width: 620px;
		margin-left: auto;
		margin-right: auto;
	}

	/* Status card */
	.status-card {
		background: rgba(16, 185, 129, 0.06);
		border: 1px solid rgba(16, 185, 129, 0.25);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
		margin: 0 auto 2.5rem;
		max-width: 600px;
		text-align: left;
	}

	.status-card-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.4rem;
	}

	.status-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
		animation: pulseDot 2s infinite ease-in-out;
	}

	@keyframes pulseDot {
		0%, 100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.15); opacity: 0.8; }
	}

	.status-heading {
		font-size: 0.95rem;
		color: #065f46;
	}

	[data-theme='dark'] .status-heading {
		color: #34d399;
	}

	.status-note {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	/* Hero actions */
	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.35rem;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.15s ease;
		cursor: pointer;
		border: none;
		font-family: inherit;
	}

	.btn-primary {
		background: var(--accent);
		color: #ffffff;
		border: 1px solid var(--accent);
	}

	.btn-primary:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		transform: translateY(-1px);
	}

	.btn-secondary {
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		border: 1px solid rgba(37, 99, 235, 0.2);
	}

	.btn-secondary:hover {
		background: rgba(37, 99, 235, 0.15);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		border-color: rgb(var(--gray));
		color: var(--accent);
	}

	/* Troubleshooting grid */
	.troubleshooting-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
		margin-top: 3.5rem;
		padding-top: 3rem;
		border-top: 1px solid var(--border);
	}

	.trouble-card {
		background: var(--bg);
		border: 1.5px solid var(--border);
		border-radius: 12px;
		padding: 1.75rem 1.5rem;
		transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
		display: flex;
		flex-direction: column;
	}

	.trouble-card:hover {
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08);
	}

	.trouble-icon {
		width: 44px;
		height: 44px;
		border-radius: 10px;
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.2rem;
	}

	.trouble-card h3 {
		font-size: 1.15rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.5rem;
	}

	.trouble-card p {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		margin-bottom: 1.25rem;
		flex-grow: 1;
	}

	.trouble-card a {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		transition: gap 0.15s;
	}

	.trouble-card:hover a {
		gap: 0.45rem;
	}

	@media (max-width: 640px) {
		.error-main {
			padding: 1.5rem 1rem 3rem;
		}

		.error-title {
			font-size: 1.85rem;
		}

		.error-subtitle {
			font-size: 1rem;
			margin-bottom: 1.5rem;
		}

		.error-hero {
			padding: 1.5rem 0.25rem 2.5rem;
		}

		.status-card {
			padding: 1rem;
			margin-bottom: 2rem;
		}

		.hero-actions {
			flex-direction: column;
			width: 100%;
			gap: 0.65rem;
		}

		.hero-actions .btn {
			width: 100%;
			justify-content: center;
			padding: 0.8rem 1rem;
		}

		.troubleshooting-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
			margin-top: 2rem;
			padding-top: 2rem;
		}

		.trouble-card {
			padding: 1.25rem 1rem;
		}
	}

	@media (max-width: 400px) {
		.error-title {
			font-size: 1.6rem;
		}
	}
</style>
