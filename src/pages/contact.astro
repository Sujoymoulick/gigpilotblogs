---
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const pageTitle = 'Contact Us | GigPilot AI';
const pageDescription =
	'Get in touch with the GigPilot AI team. Send feedback, suggest new freelancer tools, submit editorial corrections, or discuss partnership opportunities.';

const breadcrumbs = [
	{ name: 'Contact Us', item: '/contact' },
];

const contactFaqs = [
	{
		question: 'Are GigPilot AI tools and calculators completely free to use?',
		answer:
			'Yes, 100%. All of our rate calculators, project quote tools, prompt generators, and guides are completely free with zero subscription fees, paywalls, or mandatory sign-ups.',
	},
	{
		question: 'Can I suggest a new freelancer calculator or feature?',
		answer:
			'Absolutely! We build tools based directly on community requests. Use the contact form on this page and select "Feedback / Feature Request" to share your ideas.',
	},
	{
		question: 'How quickly does your team respond to inquiries?',
		answer:
			'We typically respond to all inquiries within 24 to 48 business hours (Monday through Friday).',
	},
	{
		question: 'Do you accept guest contributions or sponsored articles?',
		answer:
			'We maintain strict editorial standards and all core guides are tested in-house. However, if you are a domain specialist with practical, hands-on freelance or AI development insights, please contact us under "Partnerships / Editorial".',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			breadcrumbs={breadcrumbs}
			faqs={contactFaqs}
		/>
	</head>
	<body>
		<Header />
		<main class="contact-main">
			<Breadcrumbs items={breadcrumbs} />

			<section class="contact-hero">
				<div class="contact-badge">Get in Touch</div>
				<h1 class="contact-title">Let's Connect &amp; Build Together</h1>
				<p class="contact-subtitle">
					Have a question about our calculators, want to suggest an AI tool, report an editorial correction, or explore a partnership? We'd love to hear from you.
				</p>
			</section>

			<div class="contact-grid">
				<!-- Left Column: Interactive Contact Form -->
				<section class="form-section">
					<div class="form-card">
						<h2 class="form-title">Send Us a Message</h2>
						<p class="form-desc">Fill out the form below and our team will get back to you promptly.</p>

						<form id="contact-form" class="contact-form" novalidate>
							<div class="form-group">
								<label for="name">Your Name <span class="required">*</span></label>
								<input
									type="text"
									id="name"
									name="name"
									required
									placeholder="e.g. Alex Morgan"
									autocomplete="name"
								/>
								<span class="field-error" id="name-error"></span>
							</div>

							<div class="form-group">
								<label for="email">Email Address <span class="required">*</span></label>
								<input
									type="email"
									id="email"
									name="email"
									required
									placeholder="e.g. alex@example.com"
									autocomplete="email"
								/>
								<span class="field-error" id="email-error"></span>
							</div>

							<div class="form-group">
								<label for="subject">Inquiry Subject <span class="required">*</span></label>
								<select id="subject" name="subject" required>
									<option value="">Select a topic...</option>
									<option value="General Question">General Inquiry</option>
									<option value="Calculator Feedback">Calculator Feedback / Feature Request</option>
									<option value="Editorial Correction">Editorial Correction / Guide Suggestion</option>
									<option value="Partnership">Partnership / Sponsorship</option>
									<option value="Technical Issue">Bug Report / Technical Issue</option>
								</select>
								<span class="field-error" id="subject-error"></span>
							</div>

							<div class="form-group">
								<label for="message">Message <span class="required">*</span></label>
								<textarea
									id="message"
									name="message"
									rows="5"
									required
									placeholder="Tell us what you need help with or share your ideas..."
								></textarea>
								<span class="field-error" id="message-error"></span>
							</div>

							<button type="submit" class="submit-btn" id="submit-btn">
								<svg class="send-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="22" y1="2" x2="11" y2="13"></line>
									<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
								</svg>
								<span>Send Message</span>
							</button>
						</form>

						<!-- Form Success State -->
						<div id="form-success" class="form-success-banner" style="display: none;">
							<div class="success-icon">
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
							</div>
							<h3>Message Received!</h3>
							<p>Thank you for reaching out to GigPilot AI. We have received your inquiry and will respond within 24–48 hours.</p>
							<button type="button" class="btn-reset-form" id="btn-reset-form">Send Another Message</button>
						</div>
					</div>
				</section>

				<!-- Right Column: Direct Channels & Info -->
				<aside class="info-section">
					<div class="info-card">
						<h3>Direct Communication Channel</h3>
						<p class="info-intro">Prefer direct email? Reach our team directly at:</p>

						<div class="channel-list">
							<div class="channel-item">
								<div class="channel-icon">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</div>
								<div class="channel-details">
									<strong>Support &amp; Inquiries</strong>
									<a href="mailto:support@gigpilotai.com">support@gigpilotai.com</a>
								</div>
							</div>
						</div>
					</div>

					<div class="response-card">
						<div class="response-header">
							<span class="response-dot"></span>
							<strong>Response Time Commitment</strong>
						</div>
						<p>
							We respect your time. All inquiries submitted via email or our contact form receive a human response within <strong>24–48 business hours</strong>.
						</p>
					</div>

					<div class="quick-links-card">
						<h4>Helpful Fast Links</h4>
						<ul>
							<li><a href="/tools/freelance-rate-calculator">Freelance Rate &amp; Quote Calculators</a></li>
							<li><a href="/blog">Browse Knowledge Hub &amp; Guides</a></li>
							<li><a href="/about">About GigPilot AI &amp; Editorial Ethics</a></li>
							<li><a href="/privacy">Privacy Policy &amp; Zero-Data Guarantee</a></li>
						</ul>
					</div>
				</aside>
			</div>

			<!-- FAQ Section -->
			<section class="contact-faq-section">
				<div class="faq-badge-wrap">
					<span class="faq-badge">Instant Answers</span>
				</div>
				<FAQAccordion
					items={contactFaqs}
					title="Frequently Asked Questions"
					subtitle="Quick answers to common questions before sending a message."
				/>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const form = document.getElementById('contact-form');
				const successBanner = document.getElementById('form-success');
				const resetBtn = document.getElementById('btn-reset-form');

				if (form) {
					form.addEventListener('submit', (e) => {
						e.preventDefault();

						let isValid = true;
						const nameInput = document.getElementById('name');
						const emailInput = document.getElementById('email');
						const subjectInput = document.getElementById('subject');
						const messageInput = document.getElementById('message');

						const nameError = document.getElementById('name-error');
						const emailError = document.getElementById('email-error');
						const subjectError = document.getElementById('subject-error');
						const messageError = document.getElementById('message-error');

						// Reset errors
						[nameError, emailError, subjectError, messageError].forEach((el) => {
							if (el) el.textContent = '';
						});

						if (!nameInput.value.trim()) {
							if (nameError) nameError.textContent = 'Please enter your name.';
							isValid = false;
						}

						const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
						if (!emailInput.value.trim() || !emailPattern.test(emailInput.value.trim())) {
							if (emailError) emailError.textContent = 'Please enter a valid email address.';
							isValid = false;
						}

						if (!subjectInput.value) {
							if (subjectError) subjectError.textContent = 'Please select a topic.';
							isValid = false;
						}

						if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
							if (messageError) messageError.textContent = 'Please provide a message of at least 10 characters.';
							isValid = false;
						}

						if (isValid) {
							// For static sites, simulate fast submission & provide mailto fallback option
							form.style.display = 'none';
							if (successBanner) {
								successBanner.style.display = 'block';
								successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
							}
						}
					});
				}

				if (resetBtn && form && successBanner) {
					resetBtn.addEventListener('click', () => {
						form.reset();
						form.style.display = 'block';
						successBanner.style.display = 'none';
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	.contact-main {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 5rem;
	}

	.contact-hero {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 3.5rem;
	}

	.contact-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.85rem;
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		border-radius: 9999px;
		margin-bottom: 1rem;
	}

	.contact-title {
		font-size: 2.8rem;
		font-weight: 800;
		color: rgb(var(--black));
		line-height: 1.15;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}

	.contact-subtitle {
		font-size: 1.15rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0;
	}

	/* Two-column layout */
	.contact-grid {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 2.5rem;
		align-items: flex-start;
		margin-bottom: 4.5rem;
	}

	/* Form Styling */
	.form-card {
		background: var(--bg);
		border: 1.5px solid var(--border);
		border-radius: 16px;
		padding: 2.25rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
	}

	.form-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.4rem;
	}

	.form-desc {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		margin: 0 0 1.75rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group label {
		font-size: 0.9rem;
		font-weight: 600;
		color: rgb(var(--black));
	}

	.required {
		color: #ef4444;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		width: 100%;
		padding: 0.85rem 1rem;
		font-size: 0.95rem;
		border: 1.5px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		color: var(--text);
		font-family: inherit;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
	}

	.field-error {
		font-size: 0.8rem;
		color: #ef4444;
		min-height: 1rem;
	}

	.submit-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		background: var(--accent);
		color: #ffffff;
		border: none;
		padding: 0.9rem 1.75rem;
		border-radius: 10px;
		font-size: 1rem;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.15s ease;
		margin-top: 0.5rem;
	}

	.submit-btn:hover {
		background: var(--accent-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
	}

	/* Success State */
	.form-success-banner {
		text-align: center;
		padding: 2.5rem 1.5rem;
		background: rgba(16, 185, 129, 0.06);
		border: 1.5px solid rgba(16, 185, 129, 0.3);
		border-radius: 12px;
	}

	.success-icon {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: #10b981;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.25rem;
	}

	.form-success-banner h3 {
		font-size: 1.4rem;
		color: rgb(var(--black));
		margin: 0 0 0.5rem;
	}

	.form-success-banner p {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		max-width: 440px;
		margin: 0 auto 1.5rem;
	}

	.btn-reset-form {
		background: var(--bg);
		color: var(--text);
		border: 1.5px solid var(--border);
		padding: 0.65rem 1.25rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s;
	}

	.btn-reset-form:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Right column info cards */
	.info-section {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.info-card {
		background: var(--bg);
		border: 1.5px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
	}

	.info-card h3 {
		font-size: 1.3rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.4rem;
	}

	.info-intro {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0 0 1.5rem;
	}

	.channel-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.channel-item {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.channel-icon {
		width: 42px;
		height: 42px;
		border-radius: 10px;
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.channel-details {
		display: flex;
		flex-direction: column;
	}

	.channel-details strong {
		font-size: 0.9rem;
		color: rgb(var(--black));
	}

	.channel-details a {
		font-size: 0.95rem;
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
	}

	.channel-details a:hover {
		text-decoration: underline;
	}

	.response-card {
		background: rgba(37, 99, 235, 0.04);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1.5rem;
	}

	.response-header {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
		color: rgb(var(--black));
		font-size: 0.95rem;
	}

	.response-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
	}

	.response-card p {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.55;
	}

	.quick-links-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1.5rem;
	}

	.quick-links-card h4 {
		font-size: 1rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.85rem;
	}

	.quick-links-card ul {
		margin: 0;
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.quick-links-card li a {
		font-size: 0.88rem;
		color: var(--accent);
		text-decoration: none;
	}

	.quick-links-card li a:hover {
		text-decoration: underline;
	}

	/* FAQ Section */
	.contact-faq-section {
		margin-top: 2rem;
		padding-top: 3.5rem;
		border-top: 1px solid var(--border);
	}

	.faq-badge-wrap {
		text-align: center;
		margin-bottom: -2.5rem;
		position: relative;
		z-index: 2;
	}

	.faq-badge {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.85rem;
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		border-radius: 9999px;
		display: inline-block;
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-bottom: 3rem;
		}

		.contact-title {
			font-size: 2.2rem;
		}

		.form-card {
			padding: 1.5rem;
		}
	}

	@media (max-width: 640px) {
		.contact-main {
			padding: 1.5rem 1rem 3.5rem;
		}

		.contact-hero {
			margin-bottom: 2rem;
		}

		.contact-title {
			font-size: 1.85rem;
		}

		.contact-subtitle {
			font-size: 1rem;
		}

		.form-card {
			padding: 1.25rem 1rem;
			border-radius: 12px;
		}

		.form-title {
			font-size: 1.3rem;
		}

		.form-group input,
		.form-group select,
		.form-group textarea {
			font-size: 16px;
			padding: 0.75rem 0.85rem;
		}

		.submit-btn {
			width: 100%;
			min-height: 48px;
		}

		.info-card {
			padding: 1.35rem 1rem;
			border-radius: 12px;
		}

		.response-card,
		.quick-links-card {
			padding: 1.15rem 1rem;
			border-radius: 12px;
		}

		.contact-faq-section {
			padding-top: 2.5rem;
		}

		.faq-badge-wrap {
			margin-bottom: -1.75rem;
		}
	}

	@media (max-width: 400px) {
		.contact-title {
			font-size: 1.65rem;
		}
	}
</style>
