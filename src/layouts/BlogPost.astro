---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	article?: boolean;
	breadcrumbs?: Array<{ name: string; item: string }>;
	canonical?: string;
	noindex?: boolean;
	slug?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = 'Freelancing',
	author = 'GigPilot AI Editorial',
	readingTime = '8 min read',
	article = true,
	breadcrumbs: customBreadcrumbs,
	canonical,
	noindex = false,
	slug = '',
} = Astro.props;

const defaultBreadcrumbs = [
	{ name: 'Blog', item: '/blog/' },
	{ name: title, item: Astro.url.pathname },
];

const breadcrumbs = customBreadcrumbs || defaultBreadcrumbs;
const fullTitle = title.includes('GigPilot AI') ? title : `${title} | GigPilot AI`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={fullTitle}
			description={description}
			image={heroImage}
			article={article}
			pubDate={pubDate}
			updatedDate={updatedDate}
			author={author}
			category={category}
			breadcrumbs={breadcrumbs}
			canonical={canonical}
			noindex={noindex}
		/>
	</head>

	<body>
		<!-- Reading Progress Bar -->
		<div class="reading-progress-track" aria-hidden="true">
			<div class="reading-progress-fill" id="reading-progress-fill"></div>
		</div>

		<Header />
		<main class="blog-main">
			<div class="blog-layout-container">
				<aside class="sidebar-slot" id="blog-sidebar-slot" aria-label="Article Checklist Sidebar">
					<!-- ChecklistTracker or Reading widget will mount here if present -->
				</aside>

				<article class="article-content">
					<Breadcrumbs items={breadcrumbs} />

					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt={`${title} - Guide illustration`} loading="eager" />}
					</div>

					<div class="prose">
						<header class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											• Last updated on <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							<h1>{title}</h1>
							<p class="description">{description}</p>
							<hr />
						</header>
						<slot />
					</div>

					<RelatedPosts currentSlug={slug} category={category} />

					<footer class="article-footer">
						<p>
							Written by <strong>{author}</strong> &mdash; {category} &mdash; {readingTime}
						</p>
						<p>
							<a href="/blog/">&larr; Back to all guides</a>
							&nbsp;|&nbsp;
							<a href="/tools/freelance-rate-calculator/">Free Rate Calculator</a>
						</p>
					</footer>
				</article>
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				// 1. Reading Progress Calculation
				function updateReadingProgress() {
					const article = document.querySelector('.article-content');
					const fill = document.getElementById('reading-progress-fill');
					const sidebarFill = document.getElementById('sidebar-reading-fill');
					const progressLabels = document.querySelectorAll('.reading-progress-value');
					if (!article) return;

					const rect = article.getBoundingClientRect();
					const articleTop = rect.top + window.scrollY;
					const articleHeight = article.offsetHeight;
					const windowHeight = window.innerHeight;
					const scrollY = window.scrollY;

					const start = articleTop;
					const end = articleTop + articleHeight - windowHeight;

					let progress = 0;
					if (end > start) {
						progress = ((scrollY - start) / (end - start)) * 100;
					} else {
						progress = scrollY >= start ? 100 : 0;
					}

					progress = Math.max(0, Math.min(100, Math.round(progress)));

					if (fill) {
						fill.style.width = progress + '%';
					}
					if (sidebarFill) {
						sidebarFill.style.width = progress + '%';
					}

					progressLabels.forEach((el) => {
						el.textContent = progress + '%';
					});
				}

				window.addEventListener('scroll', updateReadingProgress, { passive: true });
				window.addEventListener('resize', updateReadingProgress, { passive: true });
				updateReadingProgress();

				// 2. Attach Copy Buttons to Markdown Code Blocks
				function initCodeCopyButtons() {
					const codeBlocks = document.querySelectorAll('.prose pre');
					codeBlocks.forEach((pre) => {
						if (pre.closest('.prompt-card') || pre.closest('.prompt-editor-container') || pre.dataset.hasCopyButton) {
							return;
						}
						pre.dataset.hasCopyButton = 'true';

						const wrapper = document.createElement('div');
						wrapper.className = 'code-block-wrapper';
						pre.parentNode.insertBefore(wrapper, pre);
						wrapper.appendChild(pre);

						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'btn-copy-code';
						btn.setAttribute('aria-label', 'Copy code to clipboard');
						btn.innerHTML = `<svg class="copy-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span class="btn-copy-text">Copy</span>`;

						btn.addEventListener('click', async () => {
							const codeEl = pre.querySelector('code');
							const codeText = codeEl ? codeEl.innerText : pre.innerText;
							const textSpan = btn.querySelector('.btn-copy-text');
							const originalText = textSpan ? textSpan.textContent : 'Copy';

							try {
								await navigator.clipboard.writeText(codeText);
							} catch (e) {
								const ta = document.createElement('textarea');
								ta.value = codeText;
								ta.style.position = 'fixed';
								ta.style.opacity = '0';
								document.body.appendChild(ta);
								ta.select();
								document.execCommand('copy');
								document.body.removeChild(ta);
							}

							btn.classList.add('copied');
							if (textSpan) textSpan.textContent = 'Copied!';
							setTimeout(() => {
								btn.classList.remove('copied');
								if (textSpan) textSpan.textContent = originalText;
							}, 2000);
						});

						wrapper.appendChild(btn);
					});
				}

				// 3. Ensure all content links open in a new blank tab
				function initProseExternalLinks() {
					const updateLinks = () => {
						const links = document.querySelectorAll('.article-content .prose a');
						links.forEach((a) => {
							const href = a.getAttribute('href');
							if (href && !href.startsWith('#')) {
								a.setAttribute('target', '_blank');
								a.setAttribute('rel', 'noopener noreferrer');
							}
						});
					};

					updateLinks();

					// Capture clicks on any link in prose to ensure new tab target
					document.addEventListener('click', (e) => {
						const link = e.target && e.target.closest('.article-content .prose a');
						if (link) {
							const href = link.getAttribute('href');
							if (href && !href.startsWith('#')) {
								link.setAttribute('target', '_blank');
								link.setAttribute('rel', 'noopener noreferrer');
							}
						}
					}, true);
				}

				// 4. Enhance Markdown FAQ Sections to Interactive Accordions
				function initFaqAccordions() {
					const prose = document.querySelector('.article-content .prose');
					if (!prose) return;

					const headings = prose.querySelectorAll('h2');
					headings.forEach((h2) => {
						const title = h2.textContent || '';
						if (!/frequently asked questions|faq/i.test(title)) return;

						const accordionList = document.createElement('div');
						accordionList.className = 'faq-accordion-list not-prose';

						let curr = h2.nextElementSibling;
						const nodesToRemove = [];

						while (curr && curr.tagName !== 'H2' && curr.tagName !== 'HR') {
							if (curr.tagName === 'H3') {
								const question = curr.textContent || '';
								const details = document.createElement('details');
								details.className = 'faq-item';

								const summary = document.createElement('summary');
								summary.className = 'faq-summary';
								summary.innerHTML = `<span class="faq-question-text">${question}</span><span class="faq-icon-wrap" aria-hidden="true"><svg class="faq-chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>`;

								const contentDiv = document.createElement('div');
								contentDiv.className = 'faq-content';

								let answerNode = curr.nextElementSibling;
								const answerNodesToMove = [];

								while (answerNode && answerNode.tagName !== 'H3' && answerNode.tagName !== 'H2' && answerNode.tagName !== 'HR') {
									answerNodesToMove.push(answerNode);
									answerNode = answerNode.nextElementSibling;
								}

								answerNodesToMove.forEach((node) => {
									const pClone = node.cloneNode(true);
									if (pClone.tagName === 'P') pClone.className = 'faq-answer-text';
									contentDiv.appendChild(pClone);
									nodesToRemove.push(node);
								});

								details.appendChild(summary);
								details.appendChild(contentDiv);
								accordionList.appendChild(details);
								nodesToRemove.push(curr);
							}
							curr = curr.nextElementSibling;
						}

						if (accordionList.children.length > 0) {
							h2.parentNode.insertBefore(accordionList, h2.nextSibling);
							nodesToRemove.forEach((node) => node.parentNode && node.parentNode.removeChild(node));
						}
					});
				}

				// 5. Generate Table of Contents from H2 Headings
				function initTableOfContents() {
					const prose = document.querySelector('.article-content .prose');
					if (!prose) return;

					const headings = Array.from(prose.querySelectorAll('h2'));
					if (headings.length < 3) return;

					const nav = document.createElement('nav');
					nav.className = 'toc-container not-prose';
					nav.setAttribute('aria-label', 'Table of Contents');

					const title = document.createElement('div');
					title.className = 'toc-title';
					title.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg><span>Table of Contents</span>`;
					nav.appendChild(title);

					const ul = document.createElement('ul');
					ul.className = 'toc-list';

					headings.forEach((h2, index) => {
						const text = h2.textContent || '';
						if (/frequently asked questions|faq/i.test(text)) return;
						if (!h2.id) {
							h2.id = 'heading-' + (index + 1);
						}

						const li = document.createElement('li');
						li.className = 'toc-item';
						const a = document.createElement('a');
						a.href = '#' + h2.id;
						a.className = 'toc-link';
						a.textContent = text;
						li.appendChild(a);
						ul.appendChild(li);
					});

					if (ul.children.length >= 2) {
						nav.appendChild(ul);
						const header = prose.querySelector('header.title');
						if (header && header.nextSibling) {
							header.parentNode.insertBefore(nav, header.nextSibling);
						} else {
							prose.insertBefore(nav, prose.firstChild);
						}
					}
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', () => {
						updateReadingProgress();
						initCodeCopyButtons();
						initProseExternalLinks();
						initFaqAccordions();
						initTableOfContents();
					});
				} else {
					updateReadingProgress();
					initCodeCopyButtons();
					initProseExternalLinks();
					initFaqAccordions();
					initTableOfContents();
				}
			})();
		</script>
	</body>
</html>

<style>
	/* Reading Progress Bar */
	.reading-progress-track {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3.5px;
		background: transparent;
		z-index: 9999;
		pointer-events: none;
	}

	.reading-progress-fill {
		height: 100%;
		width: 0%;
		background: var(--accent);
		transition: width 0.08s ease-out;
		box-shadow: 0 0 8px var(--accent);
	}

	.blog-main {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	.blog-layout-container {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 2.5rem;
		position: relative;
	}

	.sidebar-slot {
		width: 320px;
		flex-shrink: 0;
		position: sticky;
		top: 96px;
		align-self: flex-start;
	}

	.sidebar-slot:empty {
		display: none;
	}

	.article-content {
		flex: 1;
		min-width: 0;
		max-width: 760px;
	}

	/* Center article when no sidebar is present */
	.blog-layout-container:not(:has(.sidebar-slot:not(:empty))) .article-content {
		max-width: 720px;
		margin: 0 auto;
	}

	.hero-image {
		width: 100%;
		margin-bottom: 2em;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	.prose {
		color: rgb(var(--gray-dark));
	}

	.title {
		margin-bottom: 1em;
		line-height: 1;
	}

	.title h1 {
		margin: 0.25em 0 0.5em 0;
	}

	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}

	.last-updated-on {
		font-style: italic;
		font-size: 0.85em;
	}

	.description {
		font-size: 1.15em;
		color: rgb(var(--gray));
		margin-bottom: 1em;
	}

	.article-footer {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.9em;
		color: rgb(var(--gray));
	}

	.article-footer a {
		color: var(--accent);
		text-decoration: none;
	}

	.article-footer a:hover {
		text-decoration: underline;
	}

	.article-footer p {
		margin: 0.25em 0;
	}

	/* Dynamic Code Block Copy Button Styling */
	:global(.code-block-wrapper) {
		position: relative;
		margin: 1.5em 0;
	}

	:global(.code-block-wrapper pre) {
		margin: 0 !important;
		padding-top: 2.2rem !important;
	}

	:global(.btn-copy-code) {
		position: absolute;
		top: 0.5rem;
		right: 0.6rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.6rem;
		background: rgba(30, 41, 59, 0.85);
		color: #e2e8f0;
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 6px;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		backdrop-filter: blur(4px);
		transition: all 0.15s ease;
		z-index: 5;
	}

	:global(.btn-copy-code:hover) {
		background: rgba(51, 65, 85, 0.95);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.3);
	}

	:global(.btn-copy-code:focus-visible) {
		outline: 2px solid #60a5fa;
		outline-offset: 1px;
	}

	:global(.btn-copy-code.copied) {
		background: #065f46;
		color: #34d399;
		border-color: #059669;
	}

	@media (max-width: 1024px) {
		.blog-main {
			padding: 1.5rem 1rem 3rem;
		}

		.blog-layout-container {
			flex-direction: column;
			gap: 1.5rem;
		}

		.sidebar-slot {
			width: 100%;
			position: static;
		}

		.article-content {
			max-width: 100%;
		}
	}

	@media (max-width: 640px) {
		.blog-main {
			padding: 1.25rem 0.85rem 2.5rem;
		}

		.title h1 {
			font-size: 1.85rem;
			line-height: 1.25;
		}

		.description {
			font-size: 1rem;
			line-height: 1.55;
		}

		.hero-image {
			margin-bottom: 1.25em;
		}

		.article-footer {
			margin-top: 2rem;
			padding-top: 1.25rem;
		}
	}

	@media (max-width: 400px) {
		.blog-main {
			padding: 1rem 0.75rem 2rem;
		}

		.title h1 {
			font-size: 1.65rem;
		}
	}

	/* Table of Contents Styling */
	:global(.toc-container) {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-left: 4px solid var(--accent, #3b82f6);
		border-radius: 10px;
		padding: 1.25rem 1.5rem;
		margin: 1.75rem 0 2rem 0;
	}

	:global([data-theme='dark'] .toc-container) {
		background: #1e293b;
		border-color: #334155;
		border-left-color: var(--accent, #3b82f6);
	}

	:global(.toc-title) {
		font-weight: 700;
		font-size: 1rem;
		margin-bottom: 0.75rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #0f172a;
	}

	:global([data-theme='dark'] .toc-title) {
		color: #f8fafc;
	}

	:global(.toc-list) {
		list-style: none !important;
		padding-left: 0 !important;
		margin: 0 !important;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	:global(.toc-item) {
		margin: 0 !important;
		padding: 0 !important;
	}

	:global(.toc-link) {
		color: #2563eb;
		text-decoration: none;
		font-size: 0.93rem;
		line-height: 1.45;
		transition: color 0.15s ease;
	}

	:global([data-theme='dark'] .toc-link) {
		color: #60a5fa;
	}

	:global(.toc-link:hover) {
		text-decoration: underline;
	}
</style>
