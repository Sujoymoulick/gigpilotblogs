---
interface ChecklistItem {
	id: string;
	label: string;
	description?: string;
	targetId?: string;
}

interface ChecklistSection {
	title?: string;
	items: ChecklistItem[];
}

interface Props {
	storageKey?: string;
	title?: string;
	items?: ChecklistItem[];
	sections?: ChecklistSection[];
}

const {
	storageKey = 'gigpilotai-checklist-build-astro-cloudflare',
	title = 'Website Launch Progress Tracker',
	items,
	sections,
} = Astro.props;

const dataSectionsAttr = sections
	? JSON.stringify(sections)
	: items
		? JSON.stringify([{ title: '', items }])
		: '';
---

<aside class="checklist-sidebar-container" id="checklist-sidebar-container" data-storage-key={storageKey} data-sections={dataSectionsAttr || undefined}>
	<div class="sidebar-card">
		<!-- Summary Header & Progress -->
		<div class="sidebar-summary">
			<div class="sidebar-header-row">
				<div class="sidebar-title-group">
					<h3 class="sidebar-title">{title}</h3>
					<p class="sidebar-subtitle">Progress automatically saves in your browser.</p>
				</div>
			</div>

			<!-- Circular Progress Gauge -->
			<div class="sidebar-circle-container">
				<div class="circle-ring-wrapper" aria-hidden="true">
					<svg class="progress-ring-svg" width="92" height="92" viewBox="0 0 92 92">
						<circle
							class="progress-ring-bg"
							cx="46"
							cy="46"
							r="38"
							fill="transparent"
							stroke-width="8"
						/>
						<circle
							class="progress-ring-fill"
							id="sidebar-progress-circle"
							cx="46"
							cy="46"
							r="38"
							fill="transparent"
							stroke-width="8"
							stroke-linecap="round"
							stroke-dasharray="238.76"
							stroke-dashoffset="238.76"
							role="progressbar"
							aria-valuenow="0"
							aria-valuemin="0"
							aria-valuemax="100"
						/>
					</svg>
					<div class="circle-center-text">
						<span class="circle-percent-val" id="sidebar-percent-text">0%</span>
					</div>
				</div>
			</div>

			<!-- Progress Counts -->
			<div class="sidebar-status-meta" aria-live="polite">
				<span class="status-count-text">
					<strong id="sidebar-completed-count">0</strong> of <strong id="sidebar-total-count">0</strong> completed
				</span>
			</div>

			<!-- Reading Progress Row -->
			<div class="sidebar-reading-row" aria-label="Reading progress">
				<div class="reading-label-group">
					<span class="reading-title">Reading Progress</span>
				</div>
				<span class="reading-progress-value" id="sidebar-reading-val">0%</span>
			</div>
			<div class="reading-mini-track" aria-hidden="true">
				<div class="reading-mini-fill" id="sidebar-reading-fill"></div>
			</div>

			<!-- Reset Button -->
			<button
				type="button"
				class="btn-reset-sidebar"
				data-reset-storage-key={storageKey}
				aria-label="Reset checklist progress for this article"
			>
				<span class="reset-icon" aria-hidden="true">↺</span>
				<span>Reset Checklist</span>
			</button>
		</div>

		<hr class="sidebar-divider" />

		<!-- Complete Interactive Checklist Section -->
		<div class="sidebar-checklist-section">
			<div class="sidebar-checklist-header">
				<span class="sidebar-checklist-heading">CHECKLIST</span>
				<span class="sidebar-remaining-tag" id="sidebar-remaining-pill">0 remaining</span>
			</div>

			<div class="sidebar-checklist-scroll" id="sidebar-checklist-items" role="list">
				<!-- Dynamically populated from actual article checklist items -->
			</div>
		</div>
	</div>

	<!-- Custom Confirmation Modal for Resetting Checklist -->
	<dialog class="reset-dialog" id="reset-confirm-dialog" aria-labelledby="reset-dialog-title" aria-describedby="reset-dialog-desc">
		<div class="reset-dialog-card">
			<div class="reset-dialog-icon-wrapper">
				<div class="reset-dialog-icon-badge">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
						<path d="M3 3v5h5" />
					</svg>
				</div>
			</div>

			<div class="reset-dialog-body">
				<h4 class="reset-dialog-title" id="reset-dialog-title">Reset Checklist Progress?</h4>
				<p class="reset-dialog-desc" id="reset-dialog-desc">
					This will uncheck all completed steps and reset your progress tracker back to 0%. This action cannot be undone.
				</p>
			</div>

			<div class="reset-dialog-actions">
				<button type="button" class="btn-dialog-cancel" id="btn-dialog-cancel">
					Cancel
				</button>
				<button type="button" class="btn-dialog-confirm" id="btn-dialog-confirm">
					Yes, Reset Progress
				</button>
			</div>
		</div>
	</dialog>
</aside>

<script is:inline>
	(function () {
		const trackerContainer = document.getElementById('checklist-sidebar-container');
		const STORAGE_KEY = (trackerContainer && trackerContainer.getAttribute('data-storage-key')) || 'gigpilotai-checklist-build-astro-cloudflare';
		const RADIUS = 38;
		const CIRCUMFERENCE = 2 * Math.PI * RADIUS; // ~238.761

		function getSavedState() {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				return raw ? JSON.parse(raw) : {};
			} catch (e) {
				console.warn('Unable to read checklist state from localStorage:', e);
				return {};
			}
		}

		function saveState(state) {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
			} catch (e) {
				console.warn('Unable to save checklist state to localStorage:', e);
			}
		}

		function updateAllUI(articleCheckboxes, sidebarCheckboxes, state) {
			const total = (sidebarCheckboxes && sidebarCheckboxes.length > 0)
				? sidebarCheckboxes.length
				: (articleCheckboxes ? articleCheckboxes.length : 0);
			if (total === 0) return;

			let checkedCount = 0;
			if (articleCheckboxes && articleCheckboxes.length > 0) {
				articleCheckboxes.forEach((cb) => {
					const isChecked = state[cb.id] === true;
					cb.checked = isChecked;
				});
			}

			if (sidebarCheckboxes && sidebarCheckboxes.length > 0) {
				sidebarCheckboxes.forEach((scb) => {
					const targetId = scb.getAttribute('data-target-id');
					if (targetId) {
						const isChecked = state[targetId] === true;
						scb.checked = isChecked;
						if (isChecked) checkedCount++;
						const parentItem = scb.closest('.sidebar-check-item');
						if (parentItem) {
							if (isChecked) {
								parentItem.classList.add('is-checked');
							} else {
								parentItem.classList.remove('is-checked');
							}
						}
					}
				});
			} else {
				if (articleCheckboxes && articleCheckboxes.length > 0) {
					articleCheckboxes.forEach((cb) => {
						if (state[cb.id] === true) checkedCount++;
					});
				}
			}

			const percent = Math.round((checkedCount / total) * 100);
			const remaining = total - checkedCount;

			const countEl = document.getElementById('sidebar-completed-count');
			const totalEl = document.getElementById('sidebar-total-count');
			const percentEl = document.getElementById('sidebar-percent-text');
			const circleEl = document.getElementById('sidebar-progress-circle');
			const remainingEl = document.getElementById('sidebar-remaining-pill');

			if (countEl) countEl.textContent = String(checkedCount);
			if (totalEl) totalEl.textContent = String(total);
			if (percentEl) percentEl.textContent = percent + '%';
			if (remainingEl) {
				remainingEl.textContent = remaining === 0 ? 'All done!' : remaining + ' remaining';
			}

			if (circleEl) {
				const offset = CIRCUMFERENCE - (percent / 100) * CIRCUMFERENCE;
				circleEl.style.strokeDashoffset = String(offset);
				circleEl.setAttribute('aria-valuenow', String(percent));
			}
		}

		function createSidebarItemFromData(item) {
			const itemDiv = document.createElement('div');
			itemDiv.className = 'sidebar-check-item';
			const sId = 'sidebar-chk-' + item.id;

			itemDiv.innerHTML = `
				<input type="checkbox" id="${sId}" data-target-id="${item.id}" class="sidebar-check-input" />
				<label for="${sId}" class="sidebar-check-label" title="Toggle completion">
					<span class="sidebar-custom-box" aria-hidden="true">
						<svg class="sidebar-svg-icon" width="10" height="8" viewBox="0 0 12 10" fill="none" aria-hidden="true">
							<path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
				</label>
				<button type="button" class="sidebar-text-btn" data-target-id="${item.targetId || item.id}" title="Jump to this step in the guide">
					${item.label}
				</button>
			`;

			const btn = itemDiv.querySelector('.sidebar-text-btn');
			if (btn) {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const targetId = item.targetId || item.id;
					let targetEl = document.getElementById(targetId);
					if (!targetEl) {
						const headings = document.querySelectorAll('h2, h3, h4, [id]');
						for (const h of headings) {
							if (h.id && (h.id.toLowerCase().includes(targetId.toLowerCase()) || targetId.toLowerCase().includes(h.id.toLowerCase()))) {
								targetEl = h;
								break;
							}
							if (h.textContent && h.textContent.toLowerCase().includes(item.label.toLowerCase().slice(0, 12))) {
								targetEl = h;
								break;
							}
						}
					}
					if (targetEl) {
						targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
						const wrapper = targetEl.closest('.checklist-item') || targetEl.closest('.checkbox-wrapper') || targetEl;
						if (wrapper) {
							wrapper.classList.add('highlight-pulse');
							setTimeout(() => wrapper.classList.remove('highlight-pulse'), 1400);
						}
					}
				});
			}

			const scb = itemDiv.querySelector('input.sidebar-check-input');
			return { itemDiv, scb };
		}

		function createSidebarItem(cb) {
			const itemLi = cb.closest('.checklist-item');
			const strongEl = itemLi ? itemLi.querySelector('.label-text strong') : null;
			const labelText = strongEl ? strongEl.textContent.trim() : (cb.id || 'Task item');

			const itemDiv = document.createElement('div');
			itemDiv.className = 'sidebar-check-item';
			const sId = 'sidebar-chk-' + cb.id;

			itemDiv.innerHTML = `
				<input type="checkbox" id="${sId}" data-target-id="${cb.id}" class="sidebar-check-input" />
				<label for="${sId}" class="sidebar-check-label" title="Toggle completion">
					<span class="sidebar-custom-box" aria-hidden="true">
						<svg class="sidebar-svg-icon" width="10" height="8" viewBox="0 0 12 10" fill="none" aria-hidden="true">
							<path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
				</label>
				<button type="button" class="sidebar-text-btn" data-target-id="${cb.id}" title="Jump to this step in the guide">
					${labelText}
				</button>
			`;

			const btn = itemDiv.querySelector('.sidebar-text-btn');
			if (btn) {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const targetEl = document.getElementById(cb.id);
					if (targetEl) {
						targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
						const wrapper = targetEl.closest('.checklist-item') || targetEl.closest('.checkbox-wrapper');
						if (wrapper) {
							wrapper.classList.add('highlight-pulse');
							setTimeout(() => wrapper.classList.remove('highlight-pulse'), 1400);
						}
					}
				});
			}

			const scb = itemDiv.querySelector('input.sidebar-check-input');
			return { itemDiv, scb };
		}

		function populateSidebarChecklist(articleCheckboxes, parsedSections) {
			const scrollContainer = document.getElementById('sidebar-checklist-items');
			if (!scrollContainer) return [];

			scrollContainer.innerHTML = '';
			const sidebarCheckboxes = [];

			if (parsedSections && parsedSections.length > 0) {
				parsedSections.forEach((sec, idx) => {
					const hasTitle = sec.title && sec.title.trim().length > 0;
					const groupEl = document.createElement('div');
					groupEl.className = 'sidebar-group';

					if (hasTitle) {
						const headerEl = document.createElement('div');
						headerEl.className = 'sidebar-group-title';
						headerEl.textContent = sec.title;
						groupEl.appendChild(headerEl);
					}

					const itemsWrap = document.createElement('div');
					itemsWrap.className = 'sidebar-group-items';

					(sec.items || []).forEach((item) => {
						const { itemDiv, scb } = createSidebarItemFromData(item);
						if (scb) sidebarCheckboxes.push(scb);
						itemsWrap.appendChild(itemDiv);
					});

					groupEl.appendChild(itemsWrap);
					scrollContainer.appendChild(groupEl);
				});
				return sidebarCheckboxes;
			}

			const sectionContainers = document.querySelectorAll(
				'.interactive-checklist-container[data-storage-key="' + STORAGE_KEY + '"]'
			);

			if (sectionContainers && sectionContainers.length > 0) {
				sectionContainers.forEach((sec, idx) => {
					const titleEl = sec.querySelector('.checklist-section-title');
					const sectionTitle = titleEl ? titleEl.textContent.trim() : 'Section ' + (idx + 1);

					const groupEl = document.createElement('div');
					groupEl.className = 'sidebar-group';

					const headerEl = document.createElement('div');
					headerEl.className = 'sidebar-group-title';
					headerEl.textContent = sectionTitle;
					groupEl.appendChild(headerEl);

					const itemsWrap = document.createElement('div');
					itemsWrap.className = 'sidebar-group-items';

					const checkboxes = sec.querySelectorAll('input.checklist-checkbox');
					checkboxes.forEach((cb) => {
						const { itemDiv, scb } = createSidebarItem(cb);
						if (scb) sidebarCheckboxes.push(scb);
						itemsWrap.appendChild(itemDiv);
					});

					groupEl.appendChild(itemsWrap);
					scrollContainer.appendChild(groupEl);
				});
			} else {
				articleCheckboxes.forEach((cb) => {
					const { itemDiv, scb } = createSidebarItem(cb);
					if (scb) sidebarCheckboxes.push(scb);
					scrollContainer.appendChild(itemDiv);
				});
			}

			return sidebarCheckboxes;
		}

		function initChecklistSidebar() {
			const trackerEl = document.getElementById('checklist-sidebar-container');
			const sidebarSlot = document.getElementById('blog-sidebar-slot');

			// Move the tracker container into the dedicated left sidebar slot in BlogPost layout
			if (trackerEl && sidebarSlot && trackerEl.parentElement !== sidebarSlot) {
				sidebarSlot.appendChild(trackerEl);
			}

			const rawSections = trackerEl ? trackerEl.getAttribute('data-sections') : null;
			let parsedSections = null;
			if (rawSections) {
				try {
					parsedSections = JSON.parse(rawSections);
				} catch (e) {}
			}

			const articleCheckboxes = Array.from(
				document.querySelectorAll(
					'input.checklist-checkbox[data-storage-key="' + STORAGE_KEY + '"]'
				)
			);

			if ((!articleCheckboxes || articleCheckboxes.length === 0) && (!parsedSections || parsedSections.length === 0)) return;

			const sidebarCheckboxes = populateSidebarChecklist(articleCheckboxes, parsedSections);
			const state = getSavedState();
			updateAllUI(articleCheckboxes, sidebarCheckboxes, state);

			// Listen to Article checkbox changes
			articleCheckboxes.forEach((cb) => {
				cb.addEventListener('change', function () {
					const currentState = getSavedState();
					if (cb.checked) {
						currentState[cb.id] = true;
					} else {
						delete currentState[cb.id];
					}
					saveState(currentState);
					updateAllUI(articleCheckboxes, sidebarCheckboxes, currentState);
				});
			});

			// Listen to Sidebar checkbox changes
			sidebarCheckboxes.forEach((scb) => {
				scb.addEventListener('change', function () {
					const targetId = scb.getAttribute('data-target-id');
					if (!targetId) return;

					const currentState = getSavedState();
					if (scb.checked) {
						currentState[targetId] = true;
					} else {
						delete currentState[targetId];
					}
					saveState(currentState);
					updateAllUI(articleCheckboxes, sidebarCheckboxes, currentState);
				});
			});

			// Reset Checklist Custom Modal
			const resetBtn = document.querySelector(
				'button[data-reset-storage-key="' + STORAGE_KEY + '"]'
			);
			const resetDialog = document.getElementById('reset-confirm-dialog');
			const cancelBtn = document.getElementById('btn-dialog-cancel');
			const confirmBtn = document.getElementById('btn-dialog-confirm');

			if (resetBtn && resetDialog) {
				resetBtn.addEventListener('click', function () {
					resetDialog.showModal();
				});

				if (cancelBtn) {
					cancelBtn.addEventListener('click', function () {
						resetDialog.close();
					});
				}

				// Dismiss on backdrop click
				resetDialog.addEventListener('click', function (e) {
					const rect = resetDialog.getBoundingClientRect();
					const isInDialog =
						rect.top <= e.clientY &&
						e.clientY <= rect.top + rect.height &&
						rect.left <= e.clientX &&
						e.clientX <= rect.left + rect.width;
					if (!isInDialog) {
						resetDialog.close();
					}
				});

				if (confirmBtn) {
					confirmBtn.addEventListener('click', function () {
						try {
							localStorage.removeItem(STORAGE_KEY);
						} catch (e) {}
						updateAllUI(articleCheckboxes, sidebarCheckboxes, {});
						resetDialog.close();
					});
				}
			}

			// Initial sync & render
			updateAllUI(articleCheckboxes, sidebarCheckboxes, state);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initChecklistSidebar);
		} else {
			initChecklistSidebar();
		}
	})();
</script>

<style>
	.checklist-sidebar-container {
		width: 100%;
	}

	.sidebar-card {
		background: linear-gradient(180deg, rgba(37, 99, 235, 0.05) 0%, rgba(255, 255, 255, 0.98) 100%);
		border: 1px solid rgba(37, 99, 235, 0.25);
		border-radius: 16px;
		padding: 1.25rem;
		box-shadow: 0 4px 20px rgba(37, 99, 235, 0.08);
		display: flex;
		flex-direction: column;
		max-height: calc(100vh - 120px);
	}

	/* Summary Section */
	.sidebar-summary {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.85rem;
		width: 100%;
		flex-shrink: 0;
	}

	.sidebar-header-row {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		text-align: left;
		width: 100%;
	}

	.sidebar-icon {
		font-size: 1.4rem;
		line-height: 1.2;
		flex-shrink: 0;
	}

	.sidebar-title-group {
		flex: 1;
		min-width: 0;
	}

	.sidebar-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0;
		line-height: 1.3;
	}

	.sidebar-subtitle {
		font-size: 0.78rem;
		color: var(--text-muted);
		margin: 0.15rem 0 0 0;
		line-height: 1.3;
	}

	/* Circular Gauge */
	.sidebar-circle-container {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0.25rem 0;
	}

	.circle-ring-wrapper {
		position: relative;
		width: 92px;
		height: 92px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.progress-ring-svg {
		transform: rotate(-90deg);
		transform-origin: 50% 50%;
		display: block;
	}

	.progress-ring-bg {
		stroke: var(--bg-code);
	}

	.progress-ring-fill {
		stroke: var(--accent);
		transition: stroke-dashoffset 0.35s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.circle-center-text {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	.circle-percent-val {
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--accent);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		line-height: 1;
	}

	/* Counts */
	.sidebar-status-meta {
		font-size: 0.92rem;
		color: var(--text);
		width: 100%;
		text-align: center;
	}

	.status-count-text strong {
		color: rgb(var(--black));
		font-weight: 700;
	}

	/* Reading Progress */
	.sidebar-reading-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-top: 0.2rem;
		width: 100%;
	}

	.reading-label-group {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 600;
	}

	.reading-progress-value {
		font-weight: 700;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	.reading-mini-track {
		width: 100%;
		height: 4px;
		background: var(--bg-code);
		border-radius: 9999px;
		overflow: hidden;
		margin-bottom: 0.2rem;
	}

	.reading-mini-fill {
		height: 100%;
		width: 0%;
		background: var(--accent);
		border-radius: 9999px;
		transition: width 0.1s ease-out;
	}

	/* Reset Button */
	.btn-reset-sidebar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		background: transparent;
		color: var(--text-muted);
		border: 1px solid var(--border);
		padding: 0.45rem 0.85rem;
		border-radius: 8px;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-reset-sidebar:hover {
		color: #ef4444;
		border-color: #fca5a5;
		background: rgba(239, 68, 68, 0.05);
	}

	.btn-reset-sidebar:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.sidebar-divider {
		border: 0;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		margin: 0.85rem 0;
		width: 100%;
		flex-shrink: 0;
	}

	/* Checklist Section */
	.sidebar-checklist-section {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.sidebar-checklist-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.6rem;
		padding: 0 0.2rem;
		flex-shrink: 0;
	}

	.sidebar-checklist-heading {
		font-size: 0.76rem;
		font-weight: 800;
