---
// ThemeToggle — sun/moon button that switches between light and dark mode.
// On first load the script in BaseHead sets the initial theme; this component
// only handles the interactive toggle.
---

<button
	id="theme-toggle"
	aria-label="Toggle dark / light mode"
	title="Toggle dark / light mode"
>
	<!-- Sun icon (shown in dark mode → clicking goes to light) -->
	<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="5"/>
		<line x1="12" y1="1" x2="12" y2="3"/>
		<line x1="12" y1="21" x2="12" y2="23"/>
		<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
		<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
		<line x1="1" y1="12" x2="3" y2="12"/>
		<line x1="21" y1="12" x2="23" y2="12"/>
		<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
		<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
	</svg>
	<!-- Moon icon (shown in light mode → clicking goes to dark) -->
	<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
	</svg>
</button>

<script>
	function applyTheme(theme: string) {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
	}

	function getStoredTheme(): string | null {
		try { return localStorage.getItem('theme'); } catch { return null; }
	}

	// Sync button icon to current theme
	function syncIcon() {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		const btn = document.getElementById('theme-toggle');
		if (btn) btn.setAttribute('aria-pressed', String(isDark));
	}

	// Toggle on click
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		applyTheme(current === 'dark' ? 'light' : 'dark');
		syncIcon();
	});

	// Initial sync (theme already applied by inline script in <head>)
	syncIcon();
</script>

<style>
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		padding: 0;
		transition: color 0.15s, border-color 0.15s, background 0.15s;
		flex-shrink: 0;
	}

	button:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: rgba(96, 165, 250, 0.08);
	}

	/* Show moon in light mode (to indicate clicking → dark) */
	:root[data-theme='light'] .icon-sun,
	:root:not([data-theme='dark']) .icon-sun {
		display: none;
	}

	:root[data-theme='light'] .icon-moon,
	:root:not([data-theme='dark']) .icon-moon {
		display: block;
	}

	/* Show sun in dark mode (to indicate clicking → light) */
	:root[data-theme='dark'] .icon-sun {
		display: block;
	}

	:root[data-theme='dark'] .icon-moon {
		display: none;
	}
</style>
