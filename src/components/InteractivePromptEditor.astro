---
interface Props {
	title?: string;
	badge?: string;
}

const {
	title = 'Next.js & Vercel Portfolio Master Prompt',
	badge = 'Reusable Agent Prompt',
} = Astro.props;

const defaultTemplate = `You are an expert full-stack web developer and UI/UX designer.

Build a modern, high-performance, accessible, and fully responsive personal portfolio website using Next.js (App Router), React, TypeScript, and Tailwind CSS.

---

### Professional Background & Personal Information

- Name: [YOUR NAME]
- Professional Title: [YOUR PROFESSIONAL TITLE]
- Short Bio: [YOUR BIO]
- Primary Email: [YOUR EMAIL]
- LinkedIn Profile URL: [YOUR LINKEDIN URL]
- GitHub Profile URL: [YOUR GITHUB URL]
- Resume/CV PDF Link: [YOUR RESUME PDF URL]
- Profile Picture: [YOUR PROFILE IMAGE]
- Core Skills: [YOUR SKILLS]
- Professional Experience: [YOUR EXPERIENCE]
- Featured Projects: [YOUR PROJECTS]

---

### CRITICAL INSTRUCTION ON PROFESSIONAL BACKGROUND:
Please add your LinkedIn URL and provide your resume/CV PDF or a URL to the PDF for the full details of your professional background. Use the information in the LinkedIn profile and resume to populate detailed work achievements, quantifiable metrics, education credentials, and technical competencies.

---

### Technical Requirements:
1. Framework: Next.js (App Router with src/app directory structure)
2. Language: TypeScript (strict mode enabled)
3. Styling: Tailwind CSS with clean utility classes and custom color tokens
4. Icons: Lucide-react or clean inline SVG icons
5. Dark / Light Mode: Seamless theme switching with next-themes or local storage
6. Performance: 100% Lighthouse score target, optimal Core Web Vitals (LCP < 2.0s, CLS 0)
7. Accessibility: Semantic HTML5 elements (<header>, <nav>, <main>, <section>, <footer>), WCAG AA contrast, keyboard navigability, and ARIA attributes

---

### Sections & Page Architecture:
1. Navigation Bar:
   - Sticky/fixed header with brand logo/name
   - Smooth-scroll links to sections (#about, #skills, #experience, #projects, #contact)
   - Dark/light mode theme toggle button
   - "Download CV" CTA button linking to [YOUR RESUME PDF URL]
   - Mobile hamburger menu drawer with smooth toggle animation

2. Hero Section:
   - Engaging greeting and headline with [YOUR NAME]
   - Professional subtitle: [YOUR PROFESSIONAL TITLE]
   - High-impact bio: [YOUR BIO]
   - Profile avatar with subtle gradient border / glow: [YOUR PROFILE IMAGE]
   - Primary action buttons: "Explore Projects" & "Get in Touch"
   - Social icon links: LinkedIn ([YOUR LINKEDIN URL]), GitHub ([YOUR GITHUB URL]), and Email ([YOUR EMAIL])

3. About Me Section:
   - Compelling narrative on problem-solving philosophy, engineering approach, and career goals
   - Highlight key stats (years of experience, completed projects, open-source contributions)
   - Direct link to view full credentials on LinkedIn ([YOUR LINKEDIN URL])

4. Skills & Tech Stack:
   - Categorized badges:
     * Frontend (e.g., Next.js, React, TypeScript, Tailwind CSS, HTML5/CSS3)
     * Backend & Database (e.g., Node.js, REST APIs, PostgreSQL, Supabase)
     * DevOps & Tools (e.g., Vercel, Git, GitHub Actions, Docker, Figma)
   - Interactive hover states and clean visual groupings

5. Work Experience Timeline:
   - Chronological card timeline with company name, job title, dates, and location
   - Bullet points detailing key accomplishments and technical contributions
   - Tag badges for technologies utilized in each role

6. Featured Projects:
   - Responsive grid of interactive project cards
   - Project title, concise overview, and key features
   - Tech stack tags for each project
   - "Live Demo" external link and "Source Code" GitHub link
   - Hover zoom animation and responsive screenshot aspect ratios

7. Education & Certifications:
   - Degree, institution, honors, and year
   - Relevant professional certifications and licenses

8. Downloadable Resume / CV Section:
   - Dedicated card highlighting full resume availability
   - Direct download button linking to [YOUR RESUME PDF URL]
   - "View on LinkedIn" secondary button linking to [YOUR LINKEDIN URL]

9. Contact Section:
   - Functional contact form (Name, Email, Subject, Message) with client-side validation
   - Direct email mailto link: [YOUR EMAIL]
   - Social links: LinkedIn ([YOUR LINKEDIN URL]) and GitHub ([YOUR GITHUB URL])

10. Footer:
    - Copyright notice © 2026 [YOUR NAME]. Built with Next.js & Tailwind CSS. Hosted on Vercel.
    - Quick navigation links and back-to-top button.

---

### Code Quality & Deployment:
- Organize components neatly under src/components/ (Header, Hero, About, Skills, Experience, Projects, Contact, Footer, ThemeToggle).
- Place static assets (resume.pdf, profile.jpg, project screenshots) in public/.
- Configure app/layout.tsx with metadata (SEO title, description, Open Graph, Twitter card, favicon).
- Ensure zero TypeScript errors and zero build warnings on 'npm run build'.
- Provide clear instructions to run 'npm run dev' locally and deploy using 'vercel'.`;
---

<div class="prompt-editor-container" id="interactive-prompt-builder">
	<!-- Top Bar -->
	<div class="prompt-editor-header">
		<div class="header-left">
			<span class="prompt-editor-badge">{badge}</span>
			<h3 class="prompt-editor-title">{title}</h3>
		</div>
		<div class="header-actions">
			<button
				type="button"
				class="btn-editor-action btn-copy-customized"
				id="btn-copy-prompt-main"
				aria-label="Copy customized prompt to clipboard"
			>
				<svg class="action-svg-icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
				<span class="btn-text">Copy Prompt</span>
			</button>
		</div>
	</div>

	<!-- Instructions Notice -->
	<div class="prompt-editor-notice">
		<div class="notice-icon" aria-hidden="true">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="16" x2="12" y2="12"></line>
				<line x1="12" y1="8" x2="12.01" y2="8"></line>
			</svg>
		</div>
		<div class="notice-text">
			<strong>How to use this prompt:</strong> Fill in your personal details in the quick fields below, or directly edit the prompt in the text area. The prompt will automatically replace placeholders in real time. Click <strong>Copy Prompt</strong> when ready and paste it into your coding agent!
		</div>
	</div>

	<!-- Tab Controls -->
	<div class="prompt-tab-bar" role="tablist" aria-label="Prompt Editor Modes">
		<button
			type="button"
			role="tab"
			aria-selected="true"
			aria-controls="tab-customizer"
			id="tab-btn-customizer"
			class="tab-btn active"
		>
			<svg class="tab-svg-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="4" y1="21" x2="4" y2="14"></line>
				<line x1="4" y1="10" x2="4" y2="3"></line>
				<line x1="12" y1="21" x2="12" y2="12"></line>
				<line x1="12" y1="8" x2="12" y2="3"></line>
				<line x1="20" y1="21" x2="20" y2="16"></line>
				<line x1="20" y1="12" x2="20" y2="3"></line>
				<line x1="1" y1="14" x2="7" y2="14"></line>
				<line x1="9" y1="8" x2="15" y2="8"></line>
				<line x1="17" y1="16" x2="23" y2="16"></line>
			</svg>
			<span>Quick Customizer Fields</span>
		</button>
		<button
			type="button"
			role="tab"
			aria-selected="false"
			aria-controls="tab-editor"
			id="tab-btn-editor"
			class="tab-btn"
		>
			<svg class="tab-svg-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
				<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
			</svg>
			<span>Full Prompt Editor</span>
		</button>
	</div>

	<!-- TAB 1: Customizer Form -->
	<div class="tab-panel active" id="tab-customizer" role="tabpanel" aria-labelledby="tab-btn-customizer">
		<div class="form-grid">
			<div class="form-field">
				<label for="input-name">
					<span>Your Full Name</span>
					<span class="placeholder-tag">[YOUR NAME]</span>
				</label>
				<input
					type="text"
					id="input-name"
					name="fullName"
					autocomplete="name"
					placeholder="e.g. Alex Morgan…"
					value="Alex Morgan"
					class="form-input"
				/>
			</div>

			<div class="form-field">
				<label for="input-title">
					<span>Professional Title</span>
					<span class="placeholder-tag">[YOUR PROFESSIONAL TITLE]</span>
				</label>
				<input
					type="text"
					id="input-title"
					name="jobTitle"
					autocomplete="organization-title"
					placeholder="e.g. Full-Stack Developer & Cloud Engineer…"
					value="Full-Stack Developer & Cloud Engineer"
					class="form-input"
				/>
			</div>

			<div class="form-field full-width">
				<label for="input-bio">
					<span>Short Bio / Tagline</span>
					<span class="placeholder-tag">[YOUR BIO]</span>
				</label>
				<input
					type="text"
					id="input-bio"
					name="bio"
					autocomplete="off"
					placeholder="e.g. Crafting fast, responsive web applications with Next.js and TypeScript…"
					value="Crafting fast, responsive web applications with Next.js, React, and TypeScript."
					class="form-input"
				/>
			</div>

			<div class="form-field">
				<label for="input-email">
					<span>Primary Email</span>
					<span class="placeholder-tag">[YOUR EMAIL]</span>
				</label>
				<input
					type="email"
					id="input-email"
					name="email"
					autocomplete="email"
					spellcheck="false"
					placeholder="e.g. alex.morgan.dev@example.com…"
					value="alex.morgan.dev@example.com"
					class="form-input"
				/>
			</div>

			<div class="form-field">
				<label for="input-linkedin">
					<span>LinkedIn URL</span>
					<span class="placeholder-tag highlight">[YOUR LINKEDIN URL]</span>
				</label>
				<input
					type="url"
					id="input-linkedin"
					name="linkedin"
					autocomplete="url"
					spellcheck="false"
					placeholder="e.g. https://linkedin.com/in/alexmorgan…"
					value="https://linkedin.com/in/alexmorgan-dev"
					class="form-input"
				/>
			</div>

			<div class="form-field">
				<label for="input-github">
					<span>GitHub URL</span>
					<span class="placeholder-tag">[YOUR GITHUB URL]</span>
				</label>
				<input
					type="url"
					id="input-github"
					name="github"
					autocomplete="url"
					spellcheck="false"
					placeholder="e.g. https://github.com/alexmorgan…"
					value="https://github.com/alexmorgandev"
					class="form-input"
				/>
			</div>

			<div class="form-field">
				<label for="input-resume">
					<span>Resume/CV PDF URL or Path</span>
					<span class="placeholder-tag highlight">[YOUR RESUME PDF URL]</span>
				</label>
				<input
					type="text"
					id="input-resume"
					name="resumePath"
					autocomplete="off"
					spellcheck="false"
					placeholder="e.g. /resume.pdf or https://drive.google.com/…"
					value="/resume.pdf"
					class="form-input"
				/>
			</div>

			<div class="form-field full-width">
				<label for="input-skills">
					<span>Core Skills</span>
					<span class="placeholder-tag">[YOUR SKILLS]</span>
				</label>
				<input
					type="text"
					id="input-skills"
					name="skills"
					autocomplete="off"
					placeholder="e.g. Next.js, React, TypeScript, Tailwind CSS, Node.js, REST APIs, Vercel, Git…"
					value="Next.js 15, React 19, TypeScript, Tailwind CSS, Node.js, REST APIs, Vercel, Git"
					class="form-input"
				/>
			</div>
		</div>

		<!-- Live Preview of Customized Prompt -->
		<div class="preview-wrapper">
			<div class="preview-header">
				<span class="preview-label">Live Generated Prompt Preview:</span>
				<span class="preview-hint" aria-live="polite">Updates automatically as you type</span>
			</div>
			<div class="prompt-preview-box">
				<pre><code id="live-prompt-preview">{defaultTemplate}</code></pre>
			</div>
		</div>
	</div>

	<!-- TAB 2: Direct Textarea Editor -->
	<div class="tab-panel" id="tab-editor" role="tabpanel" aria-labelledby="tab-btn-editor">
		<div class="textarea-wrapper">
			<label for="prompt-raw-textarea" class="sr-only">Edit Full Prompt Text</label>
			<textarea
				id="prompt-raw-textarea"
				class="prompt-raw-textarea"
				rows="18"
				spellcheck="false"
				aria-label="Direct prompt code editor"
			>{defaultTemplate}</textarea>
		</div>
	</div>

	<!-- Footer Toolbar -->
	<div class="prompt-editor-footer">
		<div class="footer-left">
			<button type="button" class="btn-toolbar btn-reset-prompt" id="btn-reset-prompt" aria-label="Reset all fields to defaults">
				<svg class="toolbar-svg-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
					<path d="M3 3v5h5"></path>
				</svg>
				<span>Reset to Defaults</span>
			</button>
			<button type="button" class="btn-toolbar btn-copy-raw" id="btn-copy-raw" aria-label="Copy raw template with placeholders">
				<svg class="toolbar-svg-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
					<line x1="16" y1="13" x2="8" y2="13"></line>
					<line x1="16" y1="17" x2="8" y2="17"></line>
					<polyline points="10 9 9 9 8 9"></polyline>
				</svg>
				<span class="btn-copy-raw-text">Copy Raw Template</span>
			</button>
		</div>
		<div class="footer-right">
			<button type="button" class="btn-primary-copy" id="btn-copy-bottom" aria-label="Copy customized prompt to clipboard">
				<svg class="action-svg-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
				<span class="btn-copy-bottom-text">Copy Customized Prompt</span>
			</button>
		</div>
	</div>

	<!-- Custom Reset Dialog -->
	<dialog class="prompt-reset-dialog" id="prompt-reset-dialog" aria-labelledby="prompt-reset-dialog-title" aria-describedby="prompt-reset-dialog-desc">
		<div class="prompt-reset-dialog-card">
			<div class="prompt-reset-dialog-icon">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
					<path d="M3 3v5h5"></path>
				</svg>
			</div>
			<div class="prompt-reset-dialog-body">
				<h4 class="prompt-reset-dialog-title" id="prompt-reset-dialog-title">Reset Prompt Fields?</h4>
				<p class="prompt-reset-dialog-desc" id="prompt-reset-dialog-desc">
					This will reset all customized values back to their default starter template.
				</p>
			</div>
			<div class="prompt-reset-dialog-actions">
				<button type="button" class="btn-reset-cancel" id="btn-prompt-reset-cancel">
					Cancel
				</button>
				<button type="button" class="btn-reset-confirm" id="btn-prompt-reset-confirm">
					Reset to Defaults
				</button>
			</div>
		</div>
	</dialog>
</div>

<script is:inline define:vars={{ defaultTemplate }}>
	(function () {
		const rawTemplate = defaultTemplate;

		const inputName = document.getElementById('input-name');
		const inputTitle = document.getElementById('input-title');
		const inputBio = document.getElementById('input-bio');
		const inputEmail = document.getElementById('input-email');
		const inputLinkedin = document.getElementById('input-linkedin');
		const inputGithub = document.getElementById('input-github');
		const inputResume = document.getElementById('input-resume');
		const inputSkills = document.getElementById('input-skills');

		const previewCode = document.getElementById('live-prompt-preview');
		const rawTextarea = document.getElementById('prompt-raw-textarea');

		const tabCustomizer = document.getElementById('tab-btn-customizer');
		const tabEditor = document.getElementById('tab-btn-editor');
		const panelCustomizer = document.getElementById('tab-customizer');
		const panelEditor = document.getElementById('tab-editor');

		const btnCopyTop = document.getElementById('btn-copy-prompt-main');
		const btnCopyBottom = document.getElementById('btn-copy-bottom');
		const btnCopyRaw = document.getElementById('btn-copy-raw');
		const btnReset = document.getElementById('btn-reset-prompt');

		const resetDialog = document.getElementById('prompt-reset-dialog');
		const btnResetCancel = document.getElementById('btn-prompt-reset-cancel');
		const btnResetConfirm = document.getElementById('btn-prompt-reset-confirm');

		function generateCustomizedPrompt() {
			const name = inputName ? inputName.value.trim() || '[YOUR NAME]' : '[YOUR NAME]';
			const title = inputTitle ? inputTitle.value.trim() || '[YOUR PROFESSIONAL TITLE]' : '[YOUR PROFESSIONAL TITLE]';
			const bio = inputBio ? inputBio.value.trim() || '[YOUR BIO]' : '[YOUR BIO]';
			const email = inputEmail ? inputEmail.value.trim() || '[YOUR EMAIL]' : '[YOUR EMAIL]';
			const linkedin = inputLinkedin ? inputLinkedin.value.trim() || '[YOUR LINKEDIN URL]' : '[YOUR LINKEDIN URL]';
			const github = inputGithub ? inputGithub.value.trim() || '[YOUR GITHUB URL]' : '[YOUR GITHUB URL]';
			const resume = inputResume ? inputResume.value.trim() || '[YOUR RESUME PDF URL]' : '[YOUR RESUME PDF URL]';
			const skills = inputSkills ? inputSkills.value.trim() || '[YOUR SKILLS]' : '[YOUR SKILLS]';

			let text = rawTemplate;
			text = text.replaceAll('[YOUR NAME]', name);
			text = text.replaceAll('[YOUR PROFESSIONAL TITLE]', title);
			text = text.replaceAll('[YOUR BIO]', bio);
			text = text.replaceAll('[YOUR EMAIL]', email);
			text = text.replaceAll('[YOUR LINKEDIN URL]', linkedin);
			text = text.replaceAll('[YOUR GITHUB URL]', github);
			text = text.replaceAll('[YOUR RESUME PDF URL]', resume);
			text = text.replaceAll('[YOUR SKILLS]', skills);
			text = text.replaceAll('[YOUR PROFILE IMAGE]', '/profile.jpg');
			text = text.replaceAll('[YOUR EXPERIENCE]', 'Full-Stack Developer at Tech Innovators (2023–Present), Junior Web Developer at NextWave (2021–2023)');
			text = text.replaceAll('[YOUR PROJECTS]', '1. AI Content Studio (Next.js, OpenAI, Tailwind), 2. Freelance Invoice Engine (React, TypeScript), 3. DevPulse Analytics (Next.js, Vercel Edge)');

			return text;
		}

		function syncCustomizerToPreview() {
			const customized = generateCustomizedPrompt();
			if (previewCode) previewCode.textContent = customized;
			if (rawTextarea && document.activeElement !== rawTextarea) {
				rawTextarea.value = customized;
			}
		}

		// Attach input listeners
		const formInputs = [inputName, inputTitle, inputBio, inputEmail, inputLinkedin, inputGithub, inputResume, inputSkills];
		formInputs.forEach(input => {
			if (input) {
				input.addEventListener('input', syncCustomizerToPreview);
			}
		});

		// If user types directly in textarea, sync preview
		if (rawTextarea) {
			rawTextarea.addEventListener('input', () => {
				if (previewCode) previewCode.textContent = rawTextarea.value;
			});
		}

		// Tab switching with ARIA support
		function selectTab(activeTab, activePanel, inactiveTab, inactivePanel) {
			activeTab.classList.add('active');
			activeTab.setAttribute('aria-selected', 'true');
			activePanel.classList.add('active');

			inactiveTab.classList.remove('active');
			inactiveTab.setAttribute('aria-selected', 'false');
			inactivePanel.classList.remove('active');
		}

		if (tabCustomizer && tabEditor && panelCustomizer && panelEditor) {
			tabCustomizer.addEventListener('click', () => {
				selectTab(tabCustomizer, panelCustomizer, tabEditor, panelEditor);
			});
			tabEditor.addEventListener('click', () => {
				selectTab(tabEditor, panelEditor, tabCustomizer, panelCustomizer);
			});

			tabCustomizer.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight') {
					tabEditor.focus();
					selectTab(tabEditor, panelEditor, tabCustomizer, panelCustomizer);
				}
			});
			tabEditor.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') {
					tabCustomizer.focus();
					selectTab(tabCustomizer, panelCustomizer, tabEditor, panelEditor);
				}
			});
		}

		// Copy Helper
		async function copyContent(text, button, labelSelector, successText) {
			const label = button.querySelector(labelSelector);
			const originalText = label ? label.textContent : 'Copy';

			try {
				await navigator.clipboard.writeText(text);
			} catch (err) {
				const ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				document.execCommand('copy');
				document.body.removeChild(ta);
			}

			button.classList.add('copied');
			if (label) label.textContent = successText || 'Copied!';

			setTimeout(() => {
				button.classList.remove('copied');
				if (label) label.textContent = originalText;
			}, 2000);
		}

		function getCurrentPromptText() {
			if (panelEditor && panelEditor.classList.contains('active') && rawTextarea) {
				return rawTextarea.value;
			}
			return generateCustomizedPrompt();
		}

		if (btnCopyTop) {
			btnCopyTop.addEventListener('click', () => {
				copyContent(getCurrentPromptText(), btnCopyTop, '.btn-text', 'Copied!');
			});
		}

		if (btnCopyBottom) {
			btnCopyBottom.addEventListener('click', () => {
				copyContent(getCurrentPromptText(), btnCopyBottom, '.btn-copy-bottom-text', 'Copied Customized Prompt!');
			});
		}

		if (btnCopyRaw) {
			btnCopyRaw.addEventListener('click', () => {
				copyContent(rawTemplate, btnCopyRaw, '.btn-copy-raw-text', 'Copied Raw Template!');
			});
		}

		// Reset dialog handlers
		if (btnReset && resetDialog) {
			btnReset.addEventListener('click', () => {
				resetDialog.showModal();
			});

			if (btnResetCancel) {
				btnResetCancel.addEventListener('click', () => {
					resetDialog.close();
				});
			}

			resetDialog.addEventListener('click', (e) => {
				const rect = resetDialog.getBoundingClientRect();
				const isInDialog =
					rect.top <= e.clientY &&
					e.clientY <= rect.top + rect.height &&
					rect.left <= e.clientX &&
					e.clientX <= rect.left + rect.width;
				if (!isInDialog) {
					resetDialog.close();
				}
			});

			if (btnResetConfirm) {
				btnResetConfirm.addEventListener('click', () => {
					if (inputName) inputName.value = 'Alex Morgan';
					if (inputTitle) inputTitle.value = 'Full-Stack Developer & Cloud Engineer';
					if (inputBio) inputBio.value = 'Crafting fast, responsive web applications with Next.js, React, and TypeScript.';
					if (inputEmail) inputEmail.value = 'alex.morgan.dev@example.com';
					if (inputLinkedin) inputLinkedin.value = 'https://linkedin.com/in/alexmorgan-dev';
					if (inputGithub) inputGithub.value = 'https://github.com/alexmorgandev';
					if (inputResume) inputResume.value = '/resume.pdf';
					if (inputSkills) inputSkills.value = 'Next.js 15, React 19, TypeScript, Tailwind CSS, Node.js, REST APIs, Vercel, Git';

					syncCustomizerToPreview();
					resetDialog.close();
				});
			}
		}

		// Initial sync
		syncCustomizerToPreview();
	})();
</script>

