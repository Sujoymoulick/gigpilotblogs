---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
	currentSlug: string;
	category?: string;
}

const { currentSlug, category } = Astro.props;
const allPosts = await getCollection('blog');

// Specific relationships from prompt
const explicitMap: Record<string, string[]> = {
	'how-to-earn-money-online-without-investment': [
		'how-to-earn-money-online-for-students',
		'earn-money-online-100-a-day',
		'how-to-earn-from-freelancing',
	],
	'how-to-earn-money-online-for-students': [
		'how-to-earn-money-online-without-investment',
		'how-to-earn-from-freelancing',
		'free-excel-editor-online',
	],
	'earn-money-online-100-a-day': [
		'how-to-earn-money-online-without-investment',
		'how-to-earn-money-online-for-students',
		'how-to-earn-from-freelancing',
	],
	'how-to-earn-from-freelancing': [
		'how-to-earn-money-online-without-investment',
		'how-to-earn-money-online-for-students',
		'earn-money-online-100-a-day',
	],
	'free-pdf-to-excel-converter-no-sign-up': [
		'free-excel-editor-online',
		'how-to-earn-from-freelancing',
	],
	'free-excel-editor-online': [
		'free-pdf-to-excel-converter-no-sign-up',
		'how-to-earn-money-online-for-students',
	],
};

let relatedSlugs = explicitMap[currentSlug];
let relatedPosts: typeof allPosts = [];

if (relatedSlugs && relatedSlugs.length > 0) {
	relatedPosts = allPosts.filter((p) => relatedSlugs.includes(p.id));
} else {
	relatedPosts = allPosts
		.filter((p) => p.id !== currentSlug && (p.data.category === category || !category))
		.slice(0, 3);
}

// Fallback fill to 2 or 3 posts if needed
if (relatedPosts.length < 2) {
	const currentIds = new Set([currentSlug, ...relatedPosts.map((p) => p.id)]);
	const extra = allPosts.filter((p) => !currentIds.has(p.id)).slice(0, 3 - relatedPosts.length);
	relatedPosts = [...relatedPosts, ...extra];
}
---

{
	relatedPosts.length > 0 && (
		<section class="related-posts-section">
			<h2 class="related-heading">Related Articles</h2>
			<div class="related-grid">
				{relatedPosts.map((post) => (
					<article class="related-card">
						<a href={`/blog/${post.id}/`} class="related-card-inner">
							{post.data.heroImage && (
								<div class="related-img-wrapper">
									<Image
										width={400}
										height={225}
										src={post.data.heroImage}
										alt={post.data.title}
										class="related-img"
										loading="lazy"
									/>
								</div>
							)}
							<div class="related-card-body">
								<span class="related-badge">{post.data.category || 'Guide'}</span>
								<h3 class="related-card-title">{post.data.title}</h3>
								<p class="related-card-excerpt">{post.data.description}</p>
							</div>
						</a>
					</article>
				))}
			</div>
		</section>
	)
}

<style>
	.related-posts-section {
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(var(--gray-light), 0.8);
	}

	.related-heading {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		color: var(--heading-color, #0f172a);
	}

	[data-theme='dark'] .related-heading {
		color: #f8fafc;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25rem;
	}

	.related-card {
		background: var(--card-bg, #ffffff);
		border: 1px solid rgba(226, 232, 240, 0.8);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	[data-theme='dark'] .related-card {
		background: #1e293b;
		border-color: #334155;
	}

	.related-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
	}

	.related-card-inner {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.related-img-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #0f172a;
	}

	.related-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.related-card:hover .related-img {
		transform: scale(1.04);
	}

	.related-card-body {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.related-badge {
		align-self: flex-start;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		background: rgba(59, 130, 246, 0.1);
		color: var(--accent, #3b82f6);
		margin-bottom: 0.5rem;
	}

	.related-card-title {
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.35;
		margin: 0 0 0.5rem 0;
		color: var(--heading-color, #0f172a);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	[data-theme='dark'] .related-card-title {
		color: #f1f5f9;
	}

	.related-card-excerpt {
		font-size: 0.82rem;
		color: #64748b;
		line-height: 1.45;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	[data-theme='dark'] .related-card-excerpt {
		color: #94a3b8;
	}
</style>
