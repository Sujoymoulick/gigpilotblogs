---
interface Props {
	title: string;
	badge?: string;
	code: string;
	language?: string;
}

const {
	title,
	badge = 'Prompt',
	code,
	language = 'text',
} = Astro.props;
---

<div class="prompt-card" data-original-code={code}>
	<div class="prompt-header">
		<div class="prompt-meta">
			<span class="prompt-badge">{badge}</span>
			<span class="prompt-title">{title}</span>
		</div>
		<div class="prompt-actions">
			<button
				type="button"
				class="btn-prompt-action btn-toggle-edit"
				aria-label="Edit prompt text"
				title="Edit and customize this prompt"
			>
				<svg class="action-icon icon-edit" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
					<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
				</svg>
				<span class="btn-edit-text">Edit</span>
			</button>

			<button
				type="button"
				class="btn-prompt-action btn-reset-prompt"
				aria-label="Reset prompt to original template"
				title="Reset to default template"
				style="display: none;"
			>
				<svg class="action-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
					<path d="M3 3v5h5"></path>
				</svg>
				<span>Reset</span>
			</button>

			<button
				type="button"
				class="btn-prompt-action btn-copy-prompt"
				aria-label={`Copy ${title} to clipboard`}
				title="Copy prompt to clipboard"
			>
				<svg class="action-icon copy-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
				<span class="copy-text">Copy</span>
			</button>
		</div>
	</div>

	<div class="prompt-edit-banner" style="display: none;">
		<span class="banner-icon" aria-hidden="true">✏️</span>
		<span class="banner-text">Edit mode active — customize your variables and click <strong>Copy</strong> when ready.</span>
	</div>

	<div class="prompt-body">
		<pre class="prompt-pre"><code class={`language-${language}`}>{code}</code></pre>
		<textarea class="prompt-textarea" spellcheck="false" aria-label="Editable prompt content" style="display: none;">{code}</textarea>
	</div>
</div>

<script is:inline>
	(function () {
		function initPromptCards() {
			const promptCards = document.querySelectorAll('.prompt-card');
			promptCards.forEach((card) => {
				if (card.dataset.hasPromptInit) return;
				card.dataset.hasPromptInit = 'true';

				const originalCode = card.getAttribute('data-original-code') || '';
				const editBtn = card.querySelector('.btn-toggle-edit');
				const resetBtn = card.querySelector('.btn-reset-prompt');
				const copyBtn = card.querySelector('.btn-copy-prompt');
				const banner = card.querySelector('.prompt-edit-banner');
				const preEl = card.querySelector('.prompt-pre');
				const codeEl = card.querySelector('.prompt-pre code');
				const textarea = card.querySelector('.prompt-textarea');
				const editBtnText = editBtn ? editBtn.querySelector('.btn-edit-text') : null;
				const copyText = copyBtn ? copyBtn.querySelector('.copy-text') : null;

				let isEditing = false;

				function getCurrentContent() {
					return textarea ? textarea.value : (codeEl ? codeEl.textContent || '' : originalCode);
				}

				function updateResetVisibility() {
					if (!resetBtn || !textarea) return;
					const isModified = textarea.value !== originalCode;
					resetBtn.style.display = isModified ? 'inline-flex' : 'none';
				}

				function setEditMode(enable) {
					isEditing = enable;
					if (isEditing) {
						if (preEl) preEl.style.display = 'none';
						if (textarea) {
							textarea.style.display = 'block';
							textarea.focus();
						}
						if (banner) banner.style.display = 'flex';
						if (editBtnText) editBtnText.textContent = 'Preview';
						if (editBtn) editBtn.classList.add('active');
					} else {
						if (textarea && codeEl) {
							codeEl.textContent = textarea.value;
						}
						if (textarea) textarea.style.display = 'none';
						if (preEl) preEl.style.display = 'block';
						if (banner) banner.style.display = 'none';
						if (editBtnText) editBtnText.textContent = 'Edit';
						if (editBtn) editBtn.classList.remove('active');
					}
					updateResetVisibility();
				}

				if (editBtn) {
					editBtn.addEventListener('click', () => {
						setEditMode(!isEditing);
					});
				}

				if (textarea) {
					textarea.addEventListener('input', () => {
						updateResetVisibility();
						if (codeEl) codeEl.textContent = textarea.value;
					});
				}

				if (resetBtn) {
					resetBtn.addEventListener('click', () => {
						if (textarea) textarea.value = originalCode;
						if (codeEl) codeEl.textContent = originalCode;
						updateResetVisibility();
					});
				}

				if (copyBtn) {
					copyBtn.addEventListener('click', async () => {
						const contentToCopy = getCurrentContent();
						const originalCopyText = copyText ? copyText.textContent : 'Copy';

						try {
							await navigator.clipboard.writeText(contentToCopy);
							if (copyText) copyText.textContent = 'Copied!';
							copyBtn.classList.add('copied');
							setTimeout(() => {
								if (copyText) copyText.textContent = originalCopyText;
								copyBtn.classList.remove('copied');
							}, 2000);
						} catch (err) {
							// Fallback for older browsers
							const ta = document.createElement('textarea');
							ta.value = contentToCopy;
							ta.style.position = 'fixed';
							ta.style.opacity = '0';
							document.body.appendChild(ta);
							ta.select();
							try {
								document.execCommand('copy');
								if (copyText) copyText.textContent = 'Copied!';
								copyBtn.classList.add('copied');
								setTimeout(() => {
									if (copyText) copyText.textContent = originalCopyText;
									copyBtn.classList.remove('copied');
								}, 2000);
							} catch (e) {
								console.error('Failed to copy text:', e);
							}
							document.body.removeChild(ta);
						}
					});
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initPromptCards);
		} else {
			initPromptCards();
		}
	})();
</script>

<style>
	.prompt-card {
		margin: 1.75rem 0;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: #ffffff;
		color: rgb(var(--black));
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
		transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.prompt-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.65rem 1rem;
		background: #f8fafc;
		border-bottom: 1px solid var(--border);
		flex-wrap: wrap;
	}

	.prompt-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		flex: 1;
	}

	.prompt-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.2rem 0.5rem;
		background: rgba(37, 99, 235, 0.08);
		color: var(--accent);
		border-radius: 4px;
		border: 1px solid rgba(37, 99, 235, 0.2);
		flex-shrink: 0;
	}

	.prompt-title {
		font-size: 0.88rem;
		font-weight: 600;
		color: rgb(var(--black));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.prompt-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.btn-prompt-action {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.7rem;
		background: #ffffff;
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: 6px;
		font-size: 0.78rem;
		font-weight: 600;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
		user-select: none;
	}

	.btn-prompt-action:hover {
		background: #f1f5f9;
		color: rgb(var(--black));
		border-color: #cbd5e1;
	}

	.btn-prompt-action:active {
		transform: scale(0.98);
	}

	.btn-prompt-action:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.btn-toggle-edit.active {
		background: rgba(37, 99, 235, 0.1);
		color: var(--accent);
		border-color: var(--accent);
	}

	.btn-reset-prompt {
		color: #e11d48;
		border-color: rgba(225, 29, 72, 0.25);
		background: rgba(225, 29, 72, 0.05);
	}

	.btn-reset-prompt:hover {
		background: rgba(225, 29, 72, 0.12);
		color: #be123c;
		border-color: #e11d48;
	}

	.btn-copy-prompt.copied {
		background: #065f46;
		color: #34d399;
		border-color: #059669;
	}

	.prompt-edit-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 1rem;
		background: rgba(37, 99, 235, 0.06);
		border-bottom: 1px dashed rgba(37, 99, 235, 0.25);
		font-size: 0.78rem;
		color: var(--accent);
	}

	.prompt-body {
		position: relative;
		background: #f8fafc;
	}

	.prompt-pre {
		margin: 0;
		padding: 1.15rem;
		max-height: 480px;
		overflow-y: auto;
		overflow-x: auto;
		background: transparent;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.86rem;
		line-height: 1.6;
		color: #1e293b;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.prompt-pre code {
		background: transparent;
		padding: 0;
		border-radius: 0;
		color: inherit;
		font-family: inherit;
		font-size: inherit;
	}

	.prompt-textarea {
		width: 100%;
		min-height: 240px;
		max-height: 520px;
		padding: 1.15rem;
		margin: 0;
		border: none;
		outline: none;
		resize: vertical;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.86rem;
		line-height: 1.6;
		color: #1e293b;
		background: #ffffff;
		box-sizing: border-box;
	}

	.prompt-textarea:focus {
		background: #ffffff;
		box-shadow: inset 0 0 0 2px rgba(37, 99, 235, 0.35);
	}

	/* Dark mode */
	:global([data-theme='dark']) .prompt-card {
		border-color: #262626;
		background: #000000;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
	}

	:global([data-theme='dark']) .prompt-header {
		background: #0a0a0a;
		border-color: #222222;
	}

	:global([data-theme='dark']) .prompt-title {
		color: #f9fafb;
	}

	:global([data-theme='dark']) .prompt-badge {
		background: rgba(96, 165, 250, 0.12);
		color: #93c5fd;
		border-color: rgba(96, 165, 250, 0.25);
	}

	:global([data-theme='dark']) .btn-prompt-action {
		background: #141414;
		border-color: #262626;
		color: #d1d5db;
	}

	:global([data-theme='dark']) .btn-prompt-action:hover {
		background: #1f1f1f;
		color: #ffffff;
		border-color: #374151;
	}

	:global([data-theme='dark']) .btn-toggle-edit.active {
		background: rgba(96, 165, 250, 0.15);
		color: #93c5fd;
		border-color: #60a5fa;
	}

	:global([data-theme='dark']) .btn-reset-prompt {
		color: #fb7185;
		border-color: rgba(251, 113, 133, 0.3);
		background: rgba(251, 113, 133, 0.08);
	}

	:global([data-theme='dark']) .btn-reset-prompt:hover {
		background: rgba(251, 113, 133, 0.18);
		color: #fda4af;
		border-color: #fb7185;
	}

	:global([data-theme='dark']) .prompt-edit-banner {
		background: rgba(96, 165, 250, 0.08);
		border-bottom-color: rgba(96, 165, 250, 0.2);
		color: #93c5fd;
	}

	:global([data-theme='dark']) .prompt-body {
		background: #050505;
	}

	:global([data-theme='dark']) .prompt-pre {
		color: #e5e7eb;
	}

	:global([data-theme='dark']) .prompt-textarea {
		background: #0d0d0d;
		color: #f3f4f6;
	}

	:global([data-theme='dark']) .prompt-textarea:focus {
		background: #0d0d0d;
		box-shadow: inset 0 0 0 2px rgba(96, 165, 250, 0.4);
	}

	@media (max-width: 640px) {
		.prompt-header {
			padding: 0.65rem 0.85rem;
			gap: 0.5rem;
		}

		.prompt-meta {
			flex: 1 1 100%;
		}

		.prompt-title {
			max-width: 100%;
			white-space: normal;
			font-size: 0.85rem;
			line-height: 1.3;
		}

		.prompt-actions {
			width: 100%;
			justify-content: flex-end;
			gap: 0.4rem;
		}

		.btn-prompt-action {
			padding: 0.35rem 0.65rem;
			font-size: 0.78rem;
			min-height: 36px;
		}

		.prompt-pre {
			padding: 0.9rem 0.85rem;
			font-size: 0.82rem;
		}

		.prompt-textarea {
			font-size: 16px;
			padding: 0.9rem 0.85rem;
		}
	}
</style>
