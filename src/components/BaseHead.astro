---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_URL,
	DEFAULT_OG_IMAGE,
	DEFAULT_LOGO,
	DEFAULT_AUTHOR,
	DEFAULT_KEYWORDS,
} from '../consts';
import { Font } from 'astro:assets';
import WebMCPBridge from './WebMCPBridge.astro';

export interface BreadcrumbItemSchema {
	name: string;
	item: string;
}

export interface FAQItemSchema {
	question: string;
	answer: string;
}

export interface ToolSchema {
	name: string;
	description: string;
	applicationCategory?: string;
	operatingSystem?: string;
	price?: string;
	currency?: string;
}

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: ImageMetadata | string;
	ogType?: 'website' | 'article';
	twitterTitle?: string;
	twitterDescription?: string;
	twitterImage?: ImageMetadata | string;
	noindex?: boolean;
	keywords?: string | string[];
	image?: ImageMetadata | string;
	article?: boolean;
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	category?: string;
	breadcrumbs?: BreadcrumbItemSchema[];
	faqs?: FAQItemSchema[];
	toolSchema?: ToolSchema;
}

const siteOrigin = SITE_URL.replace(/\/$/, '');

const {
	title,
	description,
	canonical,
	ogTitle,
	ogDescription,
	ogImage,
	ogType,
	twitterTitle,
	twitterDescription,
	twitterImage,
	noindex = false,
	keywords,
	image,
	article = false,
	pubDate,
	updatedDate,
	author = DEFAULT_AUTHOR,
	category,
	breadcrumbs,
	faqs,
	toolSchema,
} = Astro.props;

// 1. Dynamic Canonical URL computation & normalization
function resolveCanonicalURL(): URL {
	if (canonical) {
		let clean = canonical;
		if (clean.startsWith('http://') || clean.startsWith('https://')) {
			const u = new URL(clean);
			if (u.pathname !== '/' && !u.pathname.endsWith('/')) {
				u.pathname = `${u.pathname}/`;
			}
			return u;
		}
		const cleanPath = clean.startsWith('/') ? clean : `/${clean}`;
		const finalPath = cleanPath === '/' ? '/' : cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
		return new URL(finalPath, siteOrigin);
	}

	// Clean current pathname: strip query params/hashes, normalize trailing slashes
	const rawPath = Astro.url.pathname;
	if (rawPath === '' || rawPath === '/') {
		return new URL('/', siteOrigin);
	}
	// For nested routes, preserve clean path with trailing slash matching sitemap standard
	const normalizedPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
	return new URL(normalizedPath, siteOrigin);
}

const canonicalURL = resolveCanonicalURL();

// 2. Open Graph & Twitter Image Resolution (Absolute URLs)
function resolveImageURL(imgSource?: ImageMetadata | string): string {
	if (!imgSource) {
		return new URL(DEFAULT_OG_IMAGE, siteOrigin).toString();
	}
	if (typeof imgSource === 'string') {
		if (imgSource.startsWith('http://') || imgSource.startsWith('https://')) {
			return imgSource;
		}
		const cleanSrc = imgSource.startsWith('/') ? imgSource : `/${imgSource}`;
		return new URL(cleanSrc, siteOrigin).toString();
	}
	// Handle Astro ImageMetadata object
	return new URL(imgSource.src, siteOrigin).toString();
}

const primaryImage = ogImage || image || DEFAULT_OG_IMAGE;
const ogImageURL = resolveImageURL(primaryImage);
const twitterImageURL = resolveImageURL(twitterImage || primaryImage);
const logoURL = new URL(DEFAULT_LOGO, siteOrigin).toString();

// 3. Metadata fallbacks
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const resolvedOgType = ogType || (article ? 'article' : 'website');
const resolvedTwitterTitle = twitterTitle || ogTitle || title;
const resolvedTwitterDescription = twitterDescription || ogDescription || description;

// 4. Keywords normalization
const resolvedKeywords = keywords
	? Array.isArray(keywords)
		? keywords.join(', ')
		: keywords
	: DEFAULT_KEYWORDS.join(', ');

// 5. Build comprehensive Schema.org JSON-LD graph
const schemaGraph: any[] = [
	{
		'@type': 'Organization',
		'@id': `${siteOrigin}/#organization`,
		name: SITE_TITLE,
		url: `${siteOrigin}/`,
		logo: {
			'@type': 'ImageObject',
			'@id': `${siteOrigin}/#logo`,
			url: logoURL,
			caption: SITE_TITLE,
		},
		description: SITE_DESCRIPTION,
	},
	{
		'@type': 'WebSite',
		'@id': `${siteOrigin}/#website`,
		url: `${siteOrigin}/`,
		name: SITE_TITLE,
		description: SITE_DESCRIPTION,
		publisher: {
			'@id': `${siteOrigin}/#organization`,
		},
		inLanguage: 'en-US',
	},
];

// Add Breadcrumbs schema
if (breadcrumbs && breadcrumbs.length > 0) {
	schemaGraph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalURL.toString()}#breadcrumb`,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: `${siteOrigin}/`,
			},
			...breadcrumbs.map((b, idx) => ({
				'@type': 'ListItem',
				position: idx + 2,
				name: b.name,
				item: b.item.startsWith('http') ? b.item : new URL(b.item.startsWith('/') ? b.item : `/${b.item}`, siteOrigin).toString(),
			})),
		],
	});
}

// Add Article Schema or WebPage Schema
if (article) {
	schemaGraph.push({
		'@type': 'Article',
		'@id': `${canonicalURL.toString()}#article`,
		isPartOf: {
			'@id': `${siteOrigin}/#website`,
		},
		headline: title,
		description: description,
		image: ogImageURL,
		datePublished: pubDate ? pubDate.toISOString() : undefined,
		dateModified: (updatedDate || pubDate) ? (updatedDate || pubDate)!.toISOString() : undefined,
		articleSection: category || 'Freelancing',
		inLanguage: 'en-US',
		author: {
			'@type': 'Person',
			name: author,
			url: `${siteOrigin}/about`,
		},
		publisher: {
			'@id': `${siteOrigin}/#organization`,
		},
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonicalURL.toString(),
		},
	});
} else {
	schemaGraph.push({
		'@type': 'WebPage',
		'@id': `${canonicalURL.toString()}#webpage`,
		url: canonicalURL.toString(),
		name: title,
		description: description,
		isPartOf: {
			'@id': `${siteOrigin}/#website`,
		},
		inLanguage: 'en-US',
	});
}

// Add SoftwareApplication / WebApplication Schema
if (toolSchema) {
	schemaGraph.push({
		'@type': 'WebApplication',
		'@id': `${canonicalURL.toString()}#webapp`,
		name: toolSchema.name,
		url: canonicalURL.toString(),
		description: toolSchema.description,
		applicationCategory: toolSchema.applicationCategory || 'BusinessApplication',
		operatingSystem: toolSchema.operatingSystem || 'All Modern Web Browsers',
		browserRequirements: 'Requires JavaScript. Requires HTML5.',
		offers: {
			'@type': 'Offer',
			price: toolSchema.price || '0',
			priceCurrency: toolSchema.currency || 'USD',
		},
		publisher: {
			'@id': `${siteOrigin}/#organization`,
		},
	});
}

// Add FAQPage Schema
if (faqs && faqs.length > 0) {
	schemaGraph.push({
		'@type': 'FAQPage',
		'@id': `${canonicalURL.toString()}#faq`,
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: faq.answer,
			},
		})),
	});
}

const schemaOrg = {
	'@context': 'https://schema.org',
	'@graph': schemaGraph,
};
---

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N54TZWKVEN"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-N54TZWKVEN');
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<!-- Prevent flash of wrong theme: set data-theme before first paint -->
<script is:inline>
	(function () {
		var stored;
		try { stored = localStorage.getItem('theme'); } catch (_) {}
		var theme = stored || 'light';
		document.documentElement.setAttribute('data-theme', theme);
	})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="sitemap" href="/sitemap.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', siteOrigin).toString()}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Search Engine Directives -->
{
	noindex ? (
		<meta name="robots" content="noindex, nofollow" />
	) : (
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
	)
}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.toString()} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{resolvedKeywords && <meta name="keywords" content={resolvedKeywords} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={resolvedOgType} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={resolvedOgTitle} />
<meta property="og:description" content={resolvedOgDescription} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={resolvedOgTitle} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{
	article && pubDate && (
		<meta property="article:published_time" content={pubDate.toISOString()} />
	)
}
{
	article && (updatedDate || pubDate) && (
		<meta property="article:modified_time" content={(updatedDate || pubDate)!.toISOString()} />
	)
}
{
	article && author && (
		<meta property="article:author" content={author} />
	)
}
{
	article && category && (
		<meta property="article:section" content={category} />
	)
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:title" content={resolvedTwitterTitle} />
<meta name="twitter:description" content={resolvedTwitterDescription} />
<meta name="twitter:image" content={twitterImageURL} />
<meta name="twitter:image:alt" content={resolvedTwitterTitle} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

<!-- Cloudflare WebMCP Agent Integration -->
<WebMCPBridge />
