---
import { SITE_TITLE } from '../consts';
import logoSrc from '../assets/gigpilot logo.png';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-info">
			<a href="/" class="footer-title">
				<img src={logoSrc.src} alt={SITE_TITLE} class="footer-logo" />
			</a>
			<span class="footer-separator">•</span>
			<span class="footer-copy">&copy; {today.getFullYear()} All rights reserved.</span>
		</div>

		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/tools/freelance-rate-calculator">Tools</a>
			<a href="/about">About</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-nav);
		border-top: 1px solid var(--border);
		padding: 2rem 1.5rem;
		margin-top: auto;
		transition: background-color 0.2s ease;
	}

	.footer-inner {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-info {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.9rem;
	}

	.footer-title {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.footer-logo {
		height: 28px;
		width: auto;
		display: block;
	}

	.footer-separator {
		color: rgb(var(--gray-border));
		font-size: 0.75rem;
	}

	.footer-copy {
		color: rgb(var(--gray));
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.footer-links a {
		font-size: 0.9rem;
		font-weight: 500;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.site-footer {
			padding: 1.75rem 1rem;
		}

		.footer-inner {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1rem;
		}

		.footer-info {
			flex-direction: column;
			gap: 0.25rem;
		}

		.footer-separator {
			display: none;
		}

		.footer-links {
			gap: 1.25rem;
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
